translate korean sentei10_9792ac1a:

    voice get_voice_filename("fed")
    federico "「어이. 나한테 술 냄새 날 것 같다고 했잖아」"


translate korean sentei10_87b7ba5b:

    voice get_voice_filename("dia")
    parca "「어머? 기억에 없네요」"


translate korean sentei10_24c847d4:

