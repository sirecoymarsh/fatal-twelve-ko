translate korean sentei12_850478ab:
    voice get_voice_filename("let")
    lete "「≪운명의 대광장≫을 뒤덮은 검은 불길은 다이애나에게서 나오고 있지?」"

# sequence: 1095
# source: scenario/012_01F.rpy:4395
