# sequence: 1086
# source: scenario/012_01F.rpy:4362
# source_jp: 「レテ！　どうして……」
translate korean sentei12_2d6b503a:
    voice get_voice_filename("rnk")
    rinka "「레테! 어째서……」"

# sequence: 1087
