      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/011_02.rpy",
      "source_line": 403,
      "speaker": "narrator",
      "source_jp": "パルカはわざとらしく咳払いをしてから、続けた。",
      "draft_ko": "파르카는 일부러 티 나게 헛기침하고 말을 이었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
