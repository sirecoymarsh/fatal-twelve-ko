# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_36046178 | scenario/005_2.rpy:2887
translate korean f005_2_s1_end_36046178:
    voice get_voice_filename("sgt")
    # ushizuka "「選定が終わるまでの約２ヵ月であれば、その金で何とかなるじゃろう」"
    ushizuka "「선정이 끝날 때까지 약 ２개월이라면 그 돈으로 어떻게든 되겠지」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_e2c91c5f | scenario/005_2.rpy:2892
translate korean f005_2_s1_end_e2c91c5f:
    voice get_voice_filename("sgt")
    # ushizuka "「あの子が選定の後どうするかは、わしが関われることではないじゃろう。じゃが贅沢をしなければ記憶が戻ったとき、帰国するくらいの金は残っているはずじゃ」"
    ushizuka "「그 아이가 선정 뒤에 어떻게 할지는 내가 관여할 일이 아니겠지. 하지만 사치하지 않는다면 기억이 돌아왔을 때 귀국할 정도의 돈은 남을 게야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_de45017b | scenario/005_2.rpy:2897
translate korean f005_2_s1_end_de45017b:
    voice get_voice_filename("rnk")
    # rinka "「そんなに……お金を……」"
    rinka "「그렇게나…… 많은 돈을……」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_e4688f77 | scenario/005_2.rpy:2902
translate korean f005_2_s1_end_e4688f77:
    voice get_voice_filename("sgt")
    # ushizuka "「選定が始まってから、わしが家にある現金をかき集めて、売れるものは全て売り……まあ色々して集めた金じゃ」"
    ushizuka "「선정이 시작되고 집에 있는 현금을 긁어모으고 팔 수 있는 건 전부 팔아서…… 뭐, 이런저런 방법으로 모은 돈이야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_2f5576c8 | scenario/005_2.rpy:2904
translate korean f005_2_s1_end_2f5576c8:
    # "彼の収入源は現在、国からの年金と補助金が主なものだと言っていた。"
    "지금 그의 주 수입원은 국가에서 지급하는 연금과 보조금이라고 했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_003e5f29 | scenario/005_2.rpy:2906
translate korean f005_2_s1_end_003e5f29:
    # "そういった制度について詳しくは知らないが、彼は一時期借金をしていたくらいだと言っていたし、100万円を集めるのはあまり大きな声では言えない手段をとった可能性もある。"
    "그런 제도는 잘 모르지만 한때 빚까지 졌다고 했으니 100만 엔을 모으려고 떳떳하게 말하기 어려운 수단을 썼을 가능성도 있다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_bf04c40e | scenario/005_2.rpy:2908
translate korean f005_2_s1_end_bf04c40e:
    # "だが、それがユウくんのためだと思うと、批判する気は失せてしまう。"
    "하지만 유우 군을 위해서라고 생각하니 비판할 마음이 사라진다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_9a7231aa | scenario/005_2.rpy:2913
translate korean f005_2_s1_end_9a7231aa:
    voice get_voice_filename("sgt")
    # ushizuka "「貯金なんぞ全部使い切ったし、口座も凍結しておったからのう、苦労したわい」"
    ushizuka "「저금 같은 건 전부 써 버렸고 계좌도 동결돼 있어서 고생했지」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_f6a242ad | scenario/005_2.rpy:2918
translate korean f005_2_s1_end_f6a242ad:
    voice get_voice_filename("sgt")
    # ushizuka "「後のことを構わず家探しをしたんじゃが片付ける気にもならんでの、家は散らかっていたじゃろう」"
    ushizuka "「뒷일은 생각하지 않고 집 안을 뒤졌는데 치울 마음도 안 들어서 집이 어질러져 있었을 게야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_14e7b571 | scenario/005_2.rpy:2923
translate korean f005_2_s1_end_14e7b571:
    voice get_voice_filename("rnk")
    # rinka "「どうりで……あ」"
    rinka "「어쩐지…… 아」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_d8148646 | scenario/005_2.rpy:2925
translate korean f005_2_s1_end_d8148646:
    # "言いかけて、私は口元を手で隠した。"
    "말하다가 나는 손으로 입을 가렸다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_8f795c51 | scenario/005_2.rpy:2927
translate korean f005_2_s1_end_8f795c51:
    # "事実ではあるが、言ってしまっては失礼だろう。"
    "사실이기는 하지만 말하면 실례일 것이다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_33a4d649 | scenario/005_2.rpy:2932
translate korean f005_2_s1_end_33a4d649:
    voice get_voice_filename("sgt")
    # ushizuka "「構わん構わん」"
    ushizuka "「괜찮다, 괜찮아」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_26842707 | scenario/005_2.rpy:2937
translate korean f005_2_s1_end_26842707:
    voice get_voice_filename("sgt")
    # ushizuka "「というわけじゃ。おぬしが心配することなど何もありゃせんよ」"
    ushizuka "「그런 게야. 네가 걱정할 건 아무것도 없어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_37f6de4f | scenario/005_2.rpy:2939
translate korean f005_2_s1_end_37f6de4f:
    # "快活にそう言うと、牛塚さんは笑った。"
    "명랑하게 말하고 우시즈카 씨는 웃었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_525dc5ea | scenario/005_2.rpy:2941
translate korean f005_2_s1_end_525dc5ea:
    # "私は一緒に笑うことはできず、ただこくりと頷いていた。"
    "나는 함께 웃지는 못하고 그저 작게 고개를 끄덕였다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_826fb4fa | scenario/005_2.rpy:2946
translate korean f005_2_s1_end_826fb4fa:
    voice get_voice_filename("sgt")
    # ushizuka "「じゃあの。また夢の世界とやらで会ったらよろしく頼むぞ」"
    ushizuka "「그럼 이만. 또 꿈의 세계라는 곳에서 만나면 잘 부탁한다」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_43742e91 | scenario/005_2.rpy:2951
translate korean f005_2_s1_end_43742e91:
    voice get_voice_filename("rnk")
    # rinka "「……はい。色々と、お世話になりました」"
    rinka "「……네. 여러모로 신세 많이 졌습니다」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_938394e3 | scenario/005_2.rpy:2956
translate korean f005_2_s1_end_938394e3:
    voice get_voice_filename("sgt")
    # ushizuka "「世話になったのはこちらじゃよ」"
    ushizuka "「신세를 진 건 이쪽이야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_a35f2e9d | scenario/005_2.rpy:2958
translate korean f005_2_s1_end_a35f2e9d:
    # "牛塚さんは、そう言い残して家の中へと戻って行った。"
    "우시즈카 씨는 그 말을 남기고 집 안으로 돌아갔다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_f0e5b086 | scenario/005_2.rpy:2960
translate korean f005_2_s1_end_f0e5b086:
    # "そう、これでいい。"
    "그래, 이걸로 됐다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_a9a2aaae | scenario/005_2.rpy:2962
translate korean f005_2_s1_end_a9a2aaae:
    # "状況は私にとって悪くないままだ。"
    "상황은 여전히 내게 나쁘지 않다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_2a7ebb93 | scenario/005_2.rpy:2964
translate korean f005_2_s1_end_2a7ebb93:
    # "それでもどこか胸にはわだかまりを残したまま、私は帰路につくのであった。"
    "그래도 가슴 한구석에 응어리를 남긴 채 나는 집으로 돌아갔다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_5b3c731f | scenario/005_2.rpy:2985
translate korean f005_2_s1_end_5b3c731f:
    # "家族……か。"
    "가족……인가."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_10a293d5 | scenario/005_2.rpy:2987
translate korean f005_2_s1_end_10a293d5:
    # "自室に帰った私は一人、牛塚さんとユウくんのことを思い返していた。"
    "방으로 돌아온 나는 혼자 우시즈카 씨와 유우 군을 떠올렸다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_c724d711 | scenario/005_2.rpy:2989
translate korean f005_2_s1_end_c724d711:
    # "誰かに何かを、与えることのできる人。"
    "누군가에게 무언가를 줄 수 있는 사람."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_2f25ce44 | scenario/005_2.rpy:2991
translate korean f005_2_s1_end_2f25ce44:
    # "私は桂子さんに、何かを与えることができたのだろうか。"
    "나는 게이코 씨에게 무언가를 줄 수 있었을까."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_1cd5be34 | scenario/005_2.rpy:2993
translate korean f005_2_s1_end_1cd5be34:
    # "私はソーニャに、何かを与えることができたのだろうか。"
    "나는 소냐에게 무언가를 줄 수 있었을까."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_ca7717dd | scenario/005_2.rpy:2995
translate korean f005_2_s1_end_ca7717dd:
    # "次の選定で間違いなく、牛塚さんは脱落する。"
    "다음 선정에서 틀림없이 우시즈카 씨는 탈락한다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_91aec811 | scenario/005_2.rpy:2997
translate korean f005_2_s1_end_91aec811:
    # "そんな彼に対して、私が何か与えることはできたのだろうか。"
    "그런 그에게 내가 무언가 줄 수 있었을까."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_933844cd | scenario/005_2.rpy:2999
translate korean f005_2_s1_end_933844cd:
    # "彼のお願いを聞いて、ユウくんのために手料理を作った。"
    "그의 부탁을 듣고 유우 군을 위해 손수 요리를 만들었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_e39aaf35 | scenario/005_2.rpy:3001
translate korean f005_2_s1_end_e39aaf35:
    # "選定の参加者にこれ以上深入りする必要などないというのに、私の心には月曜日の朝、後悔なく目覚めることができるのかという疑問がぶつかっていた。"
    "선정 참가자에게 더 이상 깊이 관여할 필요는 없는데도 월요일 아침에 후회 없이 눈을 뜰 수 있을까 하는 의문이 내 마음에 부딪혀 왔다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_92190583 | scenario/005_2.rpy:3006
translate korean f005_2_s1_end_92190583:
    voice get_voice_filename("rnk")
    # rinka "「あー、もうっ」"
    rinka "「아, 정말!」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_b6d8e43a | scenario/005_2.rpy:3008
translate korean f005_2_s1_end_b6d8e43a:
    # "もやもやするくらいなら動こうと思って、私は机に置いてあるパソコンに向かうことにした。"
    "답답해할 바엔 움직이자고 생각해 나는 책상 위 컴퓨터 앞에 앉았다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_9ae5c9ca | scenario/005_2.rpy:3030
translate korean f005_2_s1_end_9ae5c9ca:
    # "一晩開け、私は今日も学校だ。"
    "하룻밤이 지나고 오늘도 학교에 간다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_82e946be | scenario/005_2.rpy:3032
translate korean f005_2_s1_end_82e946be:
    # "昨日は調べ物で夜更かしをしてしまったから、まだ少し眠い。"
    "어제는 조사하느라 늦게까지 깨어 있어 아직 조금 졸리다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_b4d915bd | scenario/005_2.rpy:3034
translate korean f005_2_s1_end_b4d915bd:
    # "気付けばもう、今日から６月。"
    "정신을 차려 보니 벌써 오늘부터 ６월."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_0654da29 | scenario/005_2.rpy:3036
translate korean f005_2_s1_end_0654da29:
    # "みんなで遊園地に行った日が懐かしい。"
    "다 함께 놀이공원에 갔던 날이 그립다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_f31d02c4 | scenario/005_2.rpy:3038
translate korean f005_2_s1_end_f31d02c4:
    # "カレンダーを見て少しだけ驚いてから、私は学校へ行く準備を始めた。"
    "달력을 보고 조금 놀란 뒤 학교 갈 준비를 시작했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_d736c4b8 | scenario/005_2.rpy:3059
translate korean f005_2_s1_end_d736c4b8:
    # "私たちは教室で話していた。"
    "우리는 교실에서 이야기하고 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_d0c42296 | scenario/005_2.rpy:3064
translate korean f005_2_s1_end_d0c42296:
    voice get_voice_filename("mao")
    # mao "「おはよ～。りーたんたちは、文化祭の日どうするか決めた？」"
    mao "「좋은 아침~. 리땅이들은 문화제 날에 뭐 할지 정했어?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_14082798 | scenario/005_2.rpy:3069
translate korean f005_2_s1_end_14082798:
    voice get_voice_filename("rnk")
    # rinka "「どうするかって……土日でそれぞれ１時間の手伝い、でしょ？」"
    rinka "「뭘 할지라니…… 토요일이랑 일요일에 각각 １시간씩 돕는 거잖아?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_21bb3937 | scenario/005_2.rpy:3074
translate korean f005_2_s1_end_21bb3937:
    voice get_voice_filename("mhr")
    # miharu "「ぼくも、やらなくてはいけないみたいだ」"
    miharu "「나도 해야만 하는 모양이야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_77969d6f | scenario/005_2.rpy:3076
translate korean f005_2_s1_end_77969d6f:
    # "こうして話していると、ちゃんと日常に戻ってきたような気がした。"
    "이렇게 이야기하고 있으면 제대로 일상으로 돌아온 것 같은 기분이 들었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_e5612f25 | scenario/005_2.rpy:3078
translate korean f005_2_s1_end_e5612f25:
    # "来週の土日に控えた文化祭で、私たちのクラスは占いの館をやることに決まっている。"
    "다음 주말로 다가온 문화제에서 우리 반은 점집을 하기로 정해졌다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_c347af18 | scenario/005_2.rpy:3080
translate korean f005_2_s1_end_c347af18:
    # "１ヵ月を切ってから決まった企画なのでぐだぐだにならないかが心配だが、まあ、大掛かりな準備はいらないしそれなりに形にはなるだろう。"
    "１개월도 남지 않고 정해진 기획이라 흐지부지되지 않을까 걱정되지만, 뭐, 대규모 준비는 필요 없고 그럭저럭 모양은 갖추겠지."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_f386eb07 | scenario/005_2.rpy:3082
translate korean f005_2_s1_end_f386eb07:
    # "私たちは主要メンバーではないが、一応クラスでの参加になるため、手伝いをしなくてはならない。"
    "우리는 주요 인원은 아니지만 일단 반 전체가 참가하기 때문에 도와야 한다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_56a62d73 | scenario/005_2.rpy:3084
translate korean f005_2_s1_end_56a62d73:
    # "土日それぞれ１時間ずつのシフト制、らしかった。"
    "토요일과 일요일에 각각 １시간씩 교대하는 방식인 모양이다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_2e83fb2c | scenario/005_2.rpy:3089
translate korean f005_2_s1_end_2e83fb2c:
    voice get_voice_filename("mao")
    # mao "「ちーがーうーよー。うちは、それ以外の時間をどうしよっかって聞いてるの」"
    mao "「아-니-거-든-. 나는 그 외 시간에 뭘 할지 묻는 거야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_728d96f8 | scenario/005_2.rpy:3094
translate korean f005_2_s1_end_728d96f8:
    voice get_voice_filename("rnk")
    # rinka "「ああ、そうだったんだ。だったら、直未の喫茶店には行ってみたいかな」"
    rinka "「아, 그랬구나. 그렇다면 나오미네 찻집에는 가 보고 싶어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_d94350cd | scenario/005_2.rpy:3099
translate korean f005_2_s1_end_d94350cd:
    voice get_voice_filename("mhr")
    # miharu "「日辻さんの……ね」"
    miharu "「히츠지 씨의…… 말이지」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_b9cd0dd4 | scenario/005_2.rpy:3104
translate korean f005_2_s1_end_b9cd0dd4:
    voice get_voice_filename("mao")
    # mao "「別にみはるんは無理に行かなくてもいいんじゃないのぉ？」"
    mao "「굳이 미하룽은 억지로 안 가도 되지 않아?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_a59815a8 | scenario/005_2.rpy:3109
translate korean f005_2_s1_end_a59815a8:
    voice get_voice_filename("mhr")
    # miharu "「いや、凛火が行くならぼくも行くよ」"
    miharu "「아니, 린카가 간다면 나도 갈게」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_2618456e | scenario/005_2.rpy:3111
translate korean f005_2_s1_end_2618456e:
    # "学校の中くらい、直未と一緒にいても大丈夫だろう。"
    "학교 안에서만큼은 나오미와 함께 있어도 괜찮겠지."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_49b09566 | scenario/005_2.rpy:3113
translate korean f005_2_s1_end_49b09566:
    # "直未はその日のために着々と準備を進めて頑張っているのだし、私もちゃんと見届けたい。"
    "나오미는 그날을 위해 착실히 준비하며 노력 중이고 나도 제대로 지켜보고 싶다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_179ec6cc | scenario/005_2.rpy:3118
translate korean f005_2_s1_end_179ec6cc:
    voice get_voice_filename("rnk")
    # rinka "「真央は、何か案があるの？」"
    rinka "「마오는 무슨 생각이라도 있어?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_8b40254a | scenario/005_2.rpy:3123
translate korean f005_2_s1_end_8b40254a:
    voice get_voice_filename("mao")
    # mao "「ない！」"
    mao "「없어!」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_33c89852 | scenario/005_2.rpy:3128
translate korean f005_2_s1_end_33c89852:
    voice get_voice_filename("rnk")
    # rinka "「……ないんだね」"
    rinka "「……없구나」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_58cf4235 | scenario/005_2.rpy:3133
translate korean f005_2_s1_end_58cf4235:
    voice get_voice_filename("mhr")
    # miharu "「ぼくは文化部の活動にもあまり興味がないから、シフトを午前中に入れてもらう予定だよ」"
    miharu "「나는 문화부 활동에도 별로 관심이 없어서 오전 중에 교대를 넣어 달라고 할 생각이야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_bd4ca14f | scenario/005_2.rpy:3138
translate korean f005_2_s1_end_bd4ca14f:
    voice get_voice_filename("mhr")
    # miharu "「生徒は午前中まで校内にいれば、あとは帰宅してもいいことになっているからね」"
    miharu "「학생은 오전까지만 교내에 있으면 그 뒤에는 집에 가도 되니까」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_1868690c | scenario/005_2.rpy:3143
translate korean f005_2_s1_end_1868690c:
    voice get_voice_filename("rnk")
    # rinka "「なら、私もそうしようかな。他に興味あるものもないし」"
    rinka "「그럼 나도 그럴까. 달리 관심 있는 것도 없고」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_10620a6c | scenario/005_2.rpy:3148
translate korean f005_2_s1_end_10620a6c:
    voice get_voice_filename("mao")
    # mao "「冷っめてる～」"
    mao "「시큰둥하네~」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_7fa8cdc4 | scenario/005_2.rpy:3150
translate korean f005_2_s1_end_7fa8cdc4:
    # "私たちをからかう真央をよそに、私たちは食堂へ向かうのであった。"
    "우리를 놀리는 마오를 뒤로하고 우리는 식당으로 향했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_f68f7dcf | scenario/005_2.rpy:3170
translate korean f005_2_s1_end_f68f7dcf:
    voice get_voice_filename("mao")
    # mao "「んじゃ、お先～」"
    mao "「그럼 먼저 갈게~」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_b8129b44 | scenario/005_2.rpy:3174
translate korean f005_2_s1_end_b8129b44:
    # "そう言うと、真央は教室を出て行った。"
    "그렇게 말하고 마오는 교실을 나갔다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_7f39e095 | scenario/005_2.rpy:3176
translate korean f005_2_s1_end_7f39e095:
    # "どうやら今日は早く帰宅する日らしい。"
    "오늘은 일찍 집에 가는 날인 모양이다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_9650d0a1 | scenario/005_2.rpy:3178
translate korean f005_2_s1_end_9650d0a1:
    # "真央はあまり教えてはくれないが、用事が入っていることも多い。"
    "마오는 별로 알려 주지 않지만 볼일이 잡혀 있을 때도 많다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_441a948f | scenario/005_2.rpy:3180
translate korean f005_2_s1_end_441a948f:
    # "部活はやっていないが、バイトでもしているのだろうか。"
    "동아리는 하지 않는데 아르바이트라도 하는 걸까."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s1_end_10614c47 | scenario/005_2.rpy:3182
translate korean f005_2_s1_end_10614c47:
    # "海晴も丁度帰ろうとしているところだった。"
    "미하루도 마침 돌아가려던 참이었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_1_1296e2b5 | scenario/005_2.rpy:3212
translate korean f005_2_s2_1_1296e2b5:
    voice get_voice_filename("rnk", 802)
    # rinka "「また明日っ」"
    rinka "「내일 또 보자」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_1_492a689c | scenario/005_2.rpy:3217
translate korean f005_2_s2_1_492a689c:
    voice get_voice_filename("mhr", 270)
    # miharu "「……ああ。また明日だね、凛火」"
    miharu "「……그래. 내일 또 보자, 린카」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_1_779cc331 | scenario/005_2.rpy:3219
translate korean f005_2_s2_1_779cc331:
    # "他の選定の参加者たちに対し、私たちは仲間割れをしたように見せている。"
    "우리는 다른 선정 참가자들에게 서로 갈라선 것처럼 보이게 하고 있다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_1_cd8373dd | scenario/005_2.rpy:3221
translate korean f005_2_s2_1_cd8373dd:
    # "万が一見られてしまったら、嘘だと見破られてしまうかもしれない。"
    "만에 하나 들키면 거짓말이라는 걸 간파당할지도 모른다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_1_deaec8df | scenario/005_2.rpy:3223
translate korean f005_2_s2_1_deaec8df:
    # "私は海晴に声をかけて、教室を後にした。"
    "나는 미하루에게 말을 걸고 교실을 나섰다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_dcb6c239 | scenario/005_2.rpy:3233
translate korean f005_2_s2_2_dcb6c239:
    voice get_voice_filename("rnk", 803)
    # rinka "「一緒に駅まで行く？」"
    rinka "「역까지 같이 갈래?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_df3489ef | scenario/005_2.rpy:3238
translate korean f005_2_s2_2_df3489ef:
    voice get_voice_filename("mhr", 271)
    # miharu "「……本当かい？」"
    miharu "「……정말이니?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_86e6c5f9 | scenario/005_2.rpy:3240
translate korean f005_2_s2_2_86e6c5f9:
    # "そう訊き返した海晴は、荷物をまとめる手を早めた。"
    "되묻던 미하루는 짐을 정리하는 손을 서둘렀다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_6b713a50 | scenario/005_2.rpy:3242
translate korean f005_2_s2_2_6b713a50:
    # "教科書の下には、学校支給のものではない参考書も含まれていた。"
    "교과서 밑에는 학교에서 지급한 것이 아닌 참고서도 섞여 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_83bb7b2e | scenario/005_2.rpy:3247
translate korean f005_2_s2_2_83bb7b2e:
    voice get_voice_filename("rnk")
    # rinka "「そんなに焦らなくてもいいよ」"
    rinka "「그렇게 서두르지 않아도 돼」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_ae613e92 | scenario/005_2.rpy:3252
translate korean f005_2_s2_2_ae613e92:
    voice get_voice_filename("mhr")
    # miharu "「遅くなったら、君はぼくを見捨てて先に行ってしまうかもしれないからね」"
    miharu "「늦으면 네가 나를 버리고 먼저 가 버릴지도 모르니까」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_a9acdb3a | scenario/005_2.rpy:3254
translate korean f005_2_s2_2_a9acdb3a:
    # "海晴の言葉に、私は苦笑いを浮かべた。"
    "미하루의 말에 나는 쓴웃음을 지었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_2dd38f24 | scenario/005_2.rpy:3273
translate korean f005_2_s2_2_2dd38f24:
    voice get_voice_filename("rnk")
    # rinka "「昨日はありがとね」"
    rinka "「어제는 고마웠어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_bc263582 | scenario/005_2.rpy:3278
translate korean f005_2_s2_2_bc263582:
    voice get_voice_filename("mhr")
    # miharu "「大したことはしていないよ。ぼくも丁度そのことについて聞こうと思っていたところなんだ。一体何があったんだい？」"
    miharu "「대단한 건 하지 않았어. 나도 마침 그 일을 물어보려던 참이야. 대체 무슨 일이 있었던 거니?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_a7b848b2 | scenario/005_2.rpy:3283
translate korean f005_2_s2_2_a7b848b2:
    voice get_voice_filename("rnk")
    # rinka "「えっと……話すと長くなるんだけどさ」"
    rinka "「음…… 이야기하면 길어지는데」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_ae3d4f1d | scenario/005_2.rpy:3285
translate korean f005_2_s2_2_ae3d4f1d:
    # "海晴と二人きりになる以上、この話題を避けられないのは分かっていた。"
    "미하루와 단둘이 되는 이상 이 화제를 피할 수 없다는 건 알고 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_a45a0f7f | scenario/005_2.rpy:3287
translate korean f005_2_s2_2_a45a0f7f:
    # "私は、牛塚さんの家に行っていたことと、Ⅺの女性が襲撃してきたことを海晴に話した。"
    "나는 우시즈카 씨 집에 갔던 일과 Ⅺ의 여성이 습격해 온 일을 미하루에게 말했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_a79ef4a7 | scenario/005_2.rpy:3289
translate korean f005_2_s2_2_a79ef4a7:
    # "海晴は私の話の冒頭あたりから顔を歪ませ、最後には呆れてため息をついていた。"
    "미하루는 내 이야기 초반부터 얼굴을 찌푸리더니 마지막에는 기가 막힌 듯 한숨을 쉬었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_2c942677 | scenario/005_2.rpy:3294
translate korean f005_2_s2_2_2c942677:
    voice get_voice_filename("mhr")
    # miharu "「呆れを通り越して、ぼくはもはや君のことが恐いよ」"
    miharu "「기가 막히다 못해 이제는 네가 무서울 지경이야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_f0dc1d35 | scenario/005_2.rpy:3299
translate korean f005_2_s2_2_f0dc1d35:
    voice get_voice_filename("rnk")
    # rinka "「でも……何とかなってる。Ⅻの人とも、ちゃんと話せることが分かったし」"
    rinka "「그래도…… 어떻게든 됐어. Ⅻ의 사람과도 제대로 이야기할 수 있다는 걸 알았고」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_511208eb | scenario/005_2.rpy:3304
translate korean f005_2_s2_2_511208eb:
    voice get_voice_filename("mhr")
    # miharu "「話してどうするんだい？　最後には、彼のことも脱落させないといけないんだ」"
    miharu "「이야기해서 어쩌려고? 마지막에는 그도 탈락시켜야 해」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_b6e91532 | scenario/005_2.rpy:3306
translate korean f005_2_s2_2_b6e91532:
    # "自分でも楽観的だとは思っていたが、海晴は間髪入れずにそう差し込んできた。"
    "나도 낙관적이라고 생각했지만 미하루는 곧바로 그렇게 끼어들었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_3c7a5736 | scenario/005_2.rpy:3308
translate korean f005_2_s2_2_3c7a5736:
    # "私は言い返すことができず、目を逸らしてしまった。"
    "나는 반박하지 못하고 눈을 피했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_c155a7c3 | scenario/005_2.rpy:3313
translate korean f005_2_s2_2_c155a7c3:
    voice get_voice_filename("mhr")
    # miharu "「まあ、君がどんな行動をしようが否定しないし、どんなことがあってもぼくは君を守る」"
    miharu "「뭐, 네가 어떤 행동을 하든 부정하지 않을 거고 무슨 일이 있어도 나는 널 지킬 거야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_5fb07ab4 | scenario/005_2.rpy:3318
translate korean f005_2_s2_2_5fb07ab4:
    voice get_voice_filename("mhr")
    # miharu "「もっとも、君にあった出来事を話してくれないよりはいい、か」"
    miharu "「그래도 네게 있었던 일을 말해 주지 않는 것보다는 나은……가」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_c9cc3c1e | scenario/005_2.rpy:3323
translate korean f005_2_s2_2_c9cc3c1e:
    voice get_voice_filename("rnk")
    # rinka "「海晴は、何かないの？」"
    rinka "「미하루는 무슨 일 없어?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_992b1aa0 | scenario/005_2.rpy:3328
translate korean f005_2_s2_2_992b1aa0:
    voice get_voice_filename("mhr")
    # miharu "「くすっ、気になるかい？」"
    miharu "「후훗, 궁금하니?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_171206df | scenario/005_2.rpy:3330
translate korean f005_2_s2_2_171206df:
    # "海晴は微笑んで、そう問い掛けて来た。"
    "미하루는 미소 지으며 그렇게 물었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_4601d9a7 | scenario/005_2.rpy:3335
translate korean f005_2_s2_2_4601d9a7:
    voice get_voice_filename("rnk")
    # rinka "「……教えてくれないやつでしょ」"
    rinka "「……안 가르쳐 줄 거잖아」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_c4de7584 | scenario/005_2.rpy:3340
translate korean f005_2_s2_2_c4de7584:
    voice get_voice_filename("mhr")
    # miharu "「さすが凛火だ。ご名答」"
    miharu "「역시 린카야. 정답」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_4c07d281 | scenario/005_2.rpy:3342
translate korean f005_2_s2_2_4c07d281:
    # "その後は、他愛のない話をしながら駅へと向かった。"
    "그 뒤에는 시답잖은 이야기를 하며 역으로 향했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_2_c0f8eacf | scenario/005_2.rpy:3348
translate korean f005_2_s2_2_c0f8eacf:
    # "駅までついたら、お互いに「また明日」と言い、別れた。"
    "역에 도착하자 서로 「내일 또 보자」고 말하고 헤어졌다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_e6ebee3d | scenario/005_2.rpy:3378
translate korean f005_2_s2_end_e6ebee3d:
    # "昨日は、久しぶりにちゃんとお店を開けていた。"
    "어제는 오랜만에 가게 문을 제대로 열었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_8cade7f0 | scenario/005_2.rpy:3380
translate korean f005_2_s2_end_8cade7f0:
    # "お休みが連日続くと当然客足も遠のくが、たまたま前を通りかかった常連さんが寄ってくれた。"
    "며칠 연속 쉬면 당연히 손님 발길도 끊기지만 우연히 앞을 지나던 단골이 들러 주었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_5596f905 | scenario/005_2.rpy:3382
translate korean f005_2_s2_end_5596f905:
    # "お客さんのほとんどはおばあちゃんがいないという事情をある程度理解してくれているので、責めるどころかむしろ応援してくれるので、助かっている。"
    "손님 대부분은 할머니가 없다는 사정을 어느 정도 이해해 줘서 나를 나무라기는커녕 오히려 응원해 주니 큰 도움이 된다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_676c6c19 | scenario/005_2.rpy:3387
translate korean f005_2_s2_end_676c6c19:
    voice get_voice_filename("mao")
    # mao "「りーたん、文化祭の次の週、どっか行かない？」"
    mao "「리땅, 문화제 다음 주에 어디 안 갈래?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_b2fff6a1 | scenario/005_2.rpy:3389
translate korean f005_2_s2_end_b2fff6a1:
    # "帰りがけ、話しかけてきたのは真央だった。"
    "돌아가는 길에 말을 걸어 온 건 마오였다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_32db7aa4 | scenario/005_2.rpy:3394
translate korean f005_2_s2_end_32db7aa4:
    voice get_voice_filename("rnk", 810)
    # rinka "「いいけど、どこに？」"
    rinka "「좋은데, 어디로?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_aaa77723 | scenario/005_2.rpy:3399
translate korean f005_2_s2_end_aaa77723:
    voice get_voice_filename("mao")
    # mao "「んー、まだ決めてないけど、映画とかカラオケとか？」"
    mao "「음, 아직 안 정했지만 영화나 노래방 같은 데?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_61b948a3 | scenario/005_2.rpy:3401
translate korean f005_2_s2_end_61b948a3:
    # "私が返事を躊躇っていると、真央はにやにやと笑ってみせた。"
    "내가 대답을 망설이자 마오는 히죽히죽 웃었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_11526ba4 | scenario/005_2.rpy:3406
translate korean f005_2_s2_end_11526ba4:
    voice get_voice_filename("mao")
    # mao "「りーたんが恥ずかしがりながら歌うとこ、また見たいのだよ……」"
    mao "「리땅이 부끄러워하면서 노래하는 거, 또 보고 싶단 말이지……」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_5c671cde | scenario/005_2.rpy:3411
translate korean f005_2_s2_end_5c671cde:
    voice get_voice_filename("rnk")
    # rinka "「……だから嫌なんだよ」"
    rinka "「……그러니까 싫다는 거야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_8e2a7647 | scenario/005_2.rpy:3416
translate korean f005_2_s2_end_8e2a7647:
    voice get_voice_filename("mao")
    # mao "「でもさ、なおりんとはまだカラオケ行ったことなかったよね？　文化祭が終わって丁度いいタイミングだと思うし、いいんじゃないかなぁ～？」"
    mao "「그래도 말이야, 나오링이랑은 아직 노래방 간 적 없지? 문화제가 끝나서 딱 좋은 때인 것 같고 괜찮지 않을까~?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_36ac0092 | scenario/005_2.rpy:3421
translate korean f005_2_s2_end_36ac0092:
    voice get_voice_filename("mao")
    # mao "「ってかさ、なおりんって歌上手いと思うんだよねー、うち。何歌うのか知らないけど、大人しい子が意外と上手かったりするしねぇ」"
    mao "「그보다 나오링은 노래 잘할 것 같단 말이지, 나는. 뭘 부를지는 모르지만 얌전한 애가 의외로 잘 부르기도 하잖아」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_96b1c36a | scenario/005_2.rpy:3426
translate korean f005_2_s2_end_96b1c36a:
    voice get_voice_filename("mao")
    # mao "「問題はみはるんのバイトだけど……、ま、何とかなる気がするなぁ」"
    mao "「문제는 미하룽 아르바이트지만…… 뭐, 어떻게든 될 것 같아」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_3dfa9cc6 | scenario/005_2.rpy:3428
translate korean f005_2_s2_end_3dfa9cc6:
    # "真央は続けざまに喋る。"
    "마오는 쉬지 않고 계속 말한다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_eae1baf9 | scenario/005_2.rpy:3430
translate korean f005_2_s2_end_eae1baf9:
    # "これは、私が反対する隙を与えない作戦だと分かっている。"
    "내가 반대할 틈을 주지 않으려는 작전이라는 걸 안다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_9201a655 | scenario/005_2.rpy:3432
translate korean f005_2_s2_end_9201a655:
    # "確かに直未がどんな歌を歌うのか興味もあるので、「いいよ」と返事をした。"
    "확실히 나오미가 어떤 노래를 부를지도 궁금해서 「좋아」라고 대답했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_e45e5bef | scenario/005_2.rpy:3437
translate korean f005_2_s2_end_e45e5bef:
    voice get_voice_filename("mao")
    # mao "「いえーい。んじゃ、ちゃんと再来週の土曜は開けといてねぇ」"
    mao "「좋았어~. 그럼 다다음 주 토요일은 꼭 비워 둬」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_9836b1cd | scenario/005_2.rpy:3442
translate korean f005_2_s2_end_9836b1cd:
    voice get_voice_filename("rnk")
    # rinka "「うん、分かった」"
    rinka "「응, 알았어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_9f16044b | scenario/005_2.rpy:3444
translate korean f005_2_s2_end_9f16044b:
    # "再来週の土曜日というと、日程的には16日だ。"
    "다다음 주 토요일이면 날짜로는 16일이다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_34e15c9a | scenario/005_2.rpy:3446
translate korean f005_2_s2_end_34e15c9a:
    # "間に、二度の選定を挟むことになる。"
    "그 사이 두 번의 선정을 거친다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_dd345bd0 | scenario/005_2.rpy:3448
translate korean f005_2_s2_end_dd345bd0:
    # "このまま行けば今週指名されることはなさそうだが、来週は分からない。"
    "이대로라면 이번 주에 지명될 일은 없을 듯하지만 다음 주는 모른다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_6a2a03b8 | scenario/005_2.rpy:3450
translate korean f005_2_s2_end_6a2a03b8:
    # "もっとも、そんな気持ちでは駄目なことくらい分かっている。"
    "하지만 그런 마음가짐으로는 안 된다는 것쯤 안다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_7278d5fb | scenario/005_2.rpy:3452
translate korean f005_2_s2_end_7278d5fb:
    # "来週も再来週もずっと、私は指名されてはいけないのだ。"
    "다음 주도 다다음 주도 계속 나는 지명되어서는 안 된다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_57fd423e | scenario/005_2.rpy:3457
translate korean f005_2_s2_end_57fd423e:
    voice get_voice_filename("mao")
    # mao "「りーたん？」"
    mao "「리땅?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_0d0bbcb7 | scenario/005_2.rpy:3459
translate korean f005_2_s2_end_0d0bbcb7:
    # "考え込んでしまった真央に「ごめんね」と伝えて、私たちは教室を後にした。"
    "생각에 잠겨 버린 마오에게 「미안해」라고 말하고 우리는 교실을 나섰다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_a4fb05ed | scenario/005_2.rpy:3478
translate korean f005_2_s2_end_a4fb05ed:
    # "新宿で少し寄り道をしたあと、私はホームで電車を待っていた。"
    "신주쿠에서 잠깐 들렀다가 나는 승강장에서 전철을 기다리고 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_7cdc95f4 | scenario/005_2.rpy:3480
translate korean f005_2_s2_end_7cdc95f4:
    # "そういえば最近あまり本屋さんに行けていなかったと思いつき、寄ってみたのだ。"
    "그러고 보니 최근 서점에 거의 못 갔다고 생각해 들러 본 것이다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_d634dfb5 | scenario/005_2.rpy:3482
translate korean f005_2_s2_end_d634dfb5:
    # "少女漫画の新刊が出ていたのを、何冊か買ってみた。"
    "순정 만화 신간이 나와 있어 몇 권 사 봤다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_dc5790d1 | scenario/005_2.rpy:3487
translate korean f005_2_s2_end_dc5790d1:
    voice get_voice_filename("nom", 265)
    # naomi "「あ、凛火先輩っ！」"
    naomi "「아, 린카 선배!」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_a3d0e088 | scenario/005_2.rpy:3489
translate korean f005_2_s2_end_a3d0e088:
    # "偶然、直未が声をかけてきた。"
    "우연히 나오미가 말을 걸어 왔다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_8fa4ef0b | scenario/005_2.rpy:3491
translate korean f005_2_s2_end_8fa4ef0b:
    # "直未も本屋さんのビニール袋を持っていたので、同じ場所にいたことになるだろう。"
    "나오미도 서점 비닐봉지를 들고 있었으니 같은 곳에 있었던 것이리라."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_d05b3388 | scenario/005_2.rpy:3493
translate korean f005_2_s2_end_d05b3388:
    # "何を買ったかという話を少ししてから、直未は目を細めて訪ねてきた。"
    "뭘 샀는지 잠시 이야기한 뒤 나오미는 눈을 가늘게 뜨고 물었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_ac095bf0 | scenario/005_2.rpy:3501
translate korean f005_2_s2_end_ac095bf0:
    voice get_voice_filename("nom")
    # naomi "「そういえば……あの子、どうなったんですか？」"
    naomi "「그러고 보니…… 그 아이는 어떻게 됐어요?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_979b0204 | scenario/005_2.rpy:3503
translate korean f005_2_s2_end_979b0204:
    # "あの子、というのはユウくんのことだろう。"
    "그 아이라는 건 유우 군이겠지."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_14058e76 | scenario/005_2.rpy:3505
translate korean f005_2_s2_end_14058e76:
    # "直未と駅で姿を見かけたときには名前を知らないどころか、私は彼のことを女の子だと思っていたことが懐かしい。"
    "나오미와 역에서 모습을 봤을 때는 이름을 모르기는커녕 그를 여자아이라고 생각했던 게 아련하다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_27571932 | scenario/005_2.rpy:3507
translate korean f005_2_s2_end_27571932:
    # "海晴には概ね話したけれど、直未にはどこまで話せばいいのか考える。"
    "미하루에게는 대강 이야기했지만 나오미에게 어디까지 말해야 할지 생각한다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_79869dc2 | scenario/005_2.rpy:3509
translate korean f005_2_s2_end_79869dc2:
    # "そして、海晴の忠告を思い出した。"
    "그리고 미하루의 충고를 떠올렸다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_6e8080dc | scenario/005_2.rpy:3514
translate korean f005_2_s2_end_6e8080dc:
    voice get_voice_filename("rnk")
    # rinka "「うーん、大丈夫だったよ」"
    rinka "「음, 괜찮았어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_dee85933 | scenario/005_2.rpy:3519
translate korean f005_2_s2_end_dee85933:
    voice get_voice_filename("nom")
    # naomi "「……そうですか」"
    naomi "「……그렇군요」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_09747fb9 | scenario/005_2.rpy:3524
translate korean f005_2_s2_end_09747fb9:
    voice get_voice_filename("rnk")
    # rinka "「……ごめんね」"
    rinka "「……미안해」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_3b10a766 | scenario/005_2.rpy:3526
translate korean f005_2_s2_end_3b10a766:
    # "短いやり取りだけど、直未もきっと思うところは多かっただろう。"
    "짧은 대화지만 나오미도 분명 여러 생각이 들었을 것이다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_bd377a95 | scenario/005_2.rpy:3528
translate korean f005_2_s2_end_bd377a95:
    # "中途半端に話すくらいならと、話さないことに決めたのだ。"
    "어중간하게 이야기할 바에는 아예 하지 않기로 정했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_05ef76a1 | scenario/005_2.rpy:3530
translate korean f005_2_s2_end_05ef76a1:
    # "直未は辛そうな表情を浮かべている。"
    "나오미는 괴로운 표정을 짓고 있다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_926ffd6b | scenario/005_2.rpy:3532
translate korean f005_2_s2_end_926ffd6b:
    # "私は心が痛くなるが、露骨に避けられている直未の方がずっと辛いことが分かるので、「でね……」と無理矢理話題を変えることで取り繕おうとした。"
    "나도 마음이 아프지만 노골적으로 피하고 있는 나오미가 훨씬 괴롭다는 걸 알기에 「그래서 말인데……」라며 억지로 화제를 바꿔 얼버무리려 했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_63b6c037 | scenario/005_2.rpy:3537
translate korean f005_2_s2_end_63b6c037:
    voice get_voice_filename("nom")
    # naomi "「先輩、どうしたんですか？」"
    naomi "「선배, 왜 그러세요?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_37841430 | scenario/005_2.rpy:3539
translate korean f005_2_s2_end_37841430:
    # "何ともなしに人混みに目をやった時、私は見覚えのあるシルエットに気がついた。"
    "무심코 인파로 눈길을 돌렸을 때 나는 익숙한 실루엣을 발견했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_254e8cb7 | scenario/005_2.rpy:3541
translate korean f005_2_s2_end_254e8cb7:
    # "直未に悟られないように向き直るが、横目でちらちらとその姿を確認していた。"
    "나오미가 눈치채지 못하게 몸을 돌렸지만 곁눈질로 흘끔흘끔 그 모습을 확인했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_22816559 | scenario/005_2.rpy:3543
translate korean f005_2_s2_end_22816559:
    # "視線の先にはⅣの少年――ユウくんがいたのだ。"
    "시선 끝에는 Ⅳ의 소년――유우 군이 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_e2045e39 | scenario/005_2.rpy:3545
translate korean f005_2_s2_end_e2045e39:
    # "彼はさも待ち合わせしているかのように、人混みの中に紛れていた。"
    "그는 마치 누군가를 기다리는 듯 인파 속에 섞여 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_c908e48c | scenario/005_2.rpy:3547
translate korean f005_2_s2_end_c908e48c:
    # "しかし、彼にこの駅で待ち合わせをするような相手がいないことを知っている。"
    "하지만 그가 이 역에서 만날 사람이 없다는 걸 알고 있다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_666e2106 | scenario/005_2.rpy:3549
translate korean f005_2_s2_end_666e2106:
    # "何食わぬ顔をしているけれど、ちらちらとこちらを見ている。"
    "아무렇지 않은 얼굴이지만 이쪽을 흘끔흘끔 보고 있다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_ca750c96 | scenario/005_2.rpy:3554
translate korean f005_2_s2_end_ca750c96:
    voice get_voice_filename("rnk")
    # rinka "「お店の買い物を思い出しちゃった。ごめん、今日は先帰ってて」"
    rinka "「가게에 살 게 생각났어. 미안, 오늘은 먼저 가」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_a25b7c7b | scenario/005_2.rpy:3559
translate korean f005_2_s2_end_a25b7c7b:
    voice get_voice_filename("nom")
    # naomi "「あ、だったら私も……」"
    naomi "「아, 그럼 저도……」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_b6553e72 | scenario/005_2.rpy:3564
translate korean f005_2_s2_end_b6553e72:
    voice get_voice_filename("rnk")
    # rinka "「ううん、大丈夫。文化祭の準備で疲れてるだろうし、ちゃんと休んだ方がいいから」"
    rinka "「아니, 괜찮아. 문화제 준비로 지쳤을 테니 제대로 쉬는 게 좋으니까」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_8346d562 | scenario/005_2.rpy:3568
translate korean f005_2_s2_end_8346d562:
    # "直未は含みのある顔で頷いた。"
    "나오미는 무언가 걸리는 표정으로 고개를 끄덕였다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_35e85265 | scenario/005_2.rpy:3572
translate korean f005_2_s2_end_35e85265:
    # "私はそのまま、直未が電車に乗るまでを見送った。"
    "나는 그대로 나오미가 전철을 탈 때까지 배웅했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_6fa0041d | scenario/005_2.rpy:3577
translate korean f005_2_s2_end_6fa0041d:
    # "一人になったのを確認してから、彼は私の方へと近付いて来た。"
    "내가 혼자가 된 걸 확인하고 그는 내 쪽으로 다가왔다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_59672033 | scenario/005_2.rpy:3582
translate korean f005_2_s2_end_59672033:
    voice get_voice_filename("yuu")
    # yuu "「……お姉ちゃん」"
    yuu "「……누나」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_d4370763 | scenario/005_2.rpy:3584
translate korean f005_2_s2_end_d4370763:
    # "私がユウくんを認識していたことは、彼も分かっていたのだろう。"
    "내가 유우 군을 알아봤다는 건 그도 알고 있었으리라."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_2647a96a | scenario/005_2.rpy:3592
translate korean f005_2_s2_end_2647a96a:
    voice get_voice_filename("yuu")
    # yuu "「お姉ちゃんにね、お願いがあるんだ」"
    yuu "「누나에게 부탁이 있어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_06525420 | scenario/005_2.rpy:3594
translate korean f005_2_s2_end_06525420:
    # "挨拶などを抜きにして、ユウくんはいきなり本題へと入った。"
    "인사도 없이 유우 군은 갑자기 본론부터 꺼냈다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_dac3901a | scenario/005_2.rpy:3596
translate korean f005_2_s2_end_dac3901a:
    # "私も彼がここにいたことに戸惑うことはなく、無言で話を聞くことにした。"
    "나도 그가 여기 있다는 데 당황하지 않고 말없이 이야기를 듣기로 했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_83e2915f | scenario/005_2.rpy:3601
translate korean f005_2_s2_end_83e2915f:
    voice get_voice_filename("yuu")
    # yuu "「おじいちゃんを家族と、会わせてあげたい」"
    yuu "「할아버지를 가족과 만나게 해 주고 싶어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_2c57a7e3 | scenario/005_2.rpy:3606
translate korean f005_2_s2_end_2c57a7e3:
    voice get_voice_filename("yuu")
    # yuu "「だから、一緒に場所を調べて欲しいんだ」"
    yuu "「그러니까 같이 있는 곳을 알아봐 줬으면 해」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_456d86c6 | scenario/005_2.rpy:3611
translate korean f005_2_s2_end_456d86c6:
    voice get_voice_filename("yuu")
    # yuu "「おじいちゃんは大丈夫って言って、もう諦めてるけど、ホントはずっと会いたがってたんだ」"
    yuu "「할아버지는 괜찮다고 하면서 이미 포기했지만 사실은 계속 만나고 싶어 했어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_3db86a97 | scenario/005_2.rpy:3616
translate korean f005_2_s2_end_3db86a97:
    voice get_voice_filename("yuu")
    # yuu "「ボクは……気付いてたよ。気付いてたけど、悔しくって。会いに行こうっていってあげられるのはボクだけなのに、言えなくって」"
    yuu "「나는…… 알고 있었어. 알고 있었지만 분했어. 만나러 가자고 말해 줄 수 있는 건 나뿐인데 말하지 못했어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_d4f7fc6d | scenario/005_2.rpy:3621
translate korean f005_2_s2_end_d4f7fc6d:
    voice get_voice_filename("yuu")
    # yuu "「今日までずっと、迷ってたんだ。ボクはどうすればいいのか、分からなかったから」"
    yuu "「오늘까지 계속 망설였어. 내가 어떻게 해야 할지 몰랐으니까」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_aaf00b64 | scenario/005_2.rpy:3626
translate korean f005_2_s2_end_aaf00b64:
    voice get_voice_filename("yuu")
    # yuu "「でも……、でも！」"
    yuu "「하지만…… 하지만!」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_f5ec1d60 | scenario/005_2.rpy:3631
translate korean f005_2_s2_end_f5ec1d60:
    voice get_voice_filename("yuu")
    # yuu "「このままじゃボクも――おじいちゃんも、後悔しちゃうから！」"
    yuu "「이대로면 나도――할아버지도 후회할 테니까!」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_82342f97 | scenario/005_2.rpy:3633
translate korean f005_2_s2_end_82342f97:
    # "ユウくんは人目もはばからず、感情的に叫んでいた。"
    "유우 군은 남의 시선도 아랑곳하지 않고 감정적으로 외쳤다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_b2594da7 | scenario/005_2.rpy:3635
translate korean f005_2_s2_end_b2594da7:
    # "彼のその感情の発露を、私は止めることはしない。"
    "나는 그가 감정을 터뜨리는 걸 막지 않았다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_6031360f | scenario/005_2.rpy:3637
translate korean f005_2_s2_end_6031360f:
    # "彼はひとしきり言い終えて、不安げな顔で私を見つめた。"
    "그는 하고 싶은 말을 다 한 뒤 불안한 얼굴로 나를 바라봤다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_11572dec | scenario/005_2.rpy:3639
translate korean f005_2_s2_end_11572dec:
    # "無理もない。普通なら彼のお願いを聞くことはしないだろうから。それでもユウくんは私ならと、そう思ったに違いない。"
    "무리도 아니다. 보통이라면 그의 부탁을 들어주지 않을 테니까. 그래도 유우 군은 나라면 들어줄 거라고 생각했을 게 틀림없다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_a246434e | scenario/005_2.rpy:3644
translate korean f005_2_s2_end_a246434e:
    voice get_voice_filename("yuu")
    # yuu "「どこにいるのか知らないし、たぶんおじいちゃんに聞いても教えてくれない」"
    yuu "「어디 있는지 모르고 아마 할아버지에게 물어도 알려 주지 않을 거야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_e78a60b5 | scenario/005_2.rpy:3649
translate korean f005_2_s2_end_e78a60b5:
    voice get_voice_filename("yuu")
    # yuu "「アレンさんはもっと無理だし……ボクにはもう頼れる人はお姉ちゃんしかいないんだ！」"
    yuu "「아렌 씨한테 부탁하는 건 더 무리고…… 이제 내가 의지할 사람은 누나밖에 없어!」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_8154ab3e | scenario/005_2.rpy:3654
translate korean f005_2_s2_end_8154ab3e:
    voice get_voice_filename("yuu")
    # yuu "「だから……」"
    yuu "「그러니까……」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_55db94f8 | scenario/005_2.rpy:3656
translate korean f005_2_s2_end_55db94f8:
    # "無言の私を見て、彼は断ることを想定したのだろうか。"
    "말없는 나를 보고 거절할 거라 생각한 걸까."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_7f584473 | scenario/005_2.rpy:3658
translate korean f005_2_s2_end_7f584473:
    # "私は少し、おかしくなっていた。"
    "나는 조금 우스워졌다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_950fcb7f | scenario/005_2.rpy:3660
translate korean f005_2_s2_end_950fcb7f:
    # "必死な彼を見て、微笑ましい気持ちになっていた。"
    "필사적인 그를 보자 대견한 마음이 들었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_12fdcea5 | scenario/005_2.rpy:3662
translate korean f005_2_s2_end_12fdcea5:
    # "だって――。"
    "왜냐하면――."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_e18f51d2 | scenario/005_2.rpy:3670
translate korean f005_2_s2_end_e18f51d2:
    voice get_voice_filename("rnk")
    # rinka "「同じ会社で異動になって地方に引っ越しただけだから、地域を特定するのはそう難しくなかったよ」"
    rinka "「같은 회사에서 발령이 나 지방으로 이사했을 뿐이니까 지역을 특정하는 건 그리 어렵지 않았어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_f670cd1d | scenario/005_2.rpy:3675
translate korean f005_2_s2_end_f670cd1d:
    voice get_voice_filename("rnk")
    # rinka "「あとは……部署をいくつか変えながら電話してみたら意外と何とかなったんだ。選定が始まってから、嘘の演技にちょっとは慣れたからかな。大体の町までは絞れたよ」"
    rinka "「그다음은…… 부서를 몇 군데 바꿔 가며 전화했더니 의외로 어떻게든 됐어. 선정이 시작된 뒤 거짓말하는 연기에도 조금은 익숙해져서일까. 대략 어느 마을인지는 좁혔어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_7a0ef94f | scenario/005_2.rpy:3680
translate korean f005_2_s2_end_7a0ef94f:
    voice get_voice_filename("yuu", 163)
    # yuu "「えっ……？」"
    yuu "「뭐……?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_e1fb1ddb | scenario/005_2.rpy:3685
translate korean f005_2_s2_end_e1fb1ddb:
    voice get_voice_filename("rnk")
    # rinka "「あとは、君の頑張り次第かな。近所の人とかに聞き込みをして、家を見つければいいよ」"
    rinka "「이제 네 노력에 달렸어. 이웃 사람들한테 물어보고 집을 찾으면 돼」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_f0b481b2 | scenario/005_2.rpy:3690
translate korean f005_2_s2_end_f0b481b2:
    voice get_voice_filename("rnk", 90001)
    # rinka "「新幹線代と今日の宿泊代は……まあ、貸してあげる。おばあちゃんには内緒だけど、後で返してくれれば大丈夫かな」"
    rinka "「신칸센 요금과 오늘 숙박비는…… 뭐, 빌려줄게. 할머니에게는 비밀이지만 나중에 갚으면 괜찮겠지」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_5d432ad6 | scenario/005_2.rpy:3695
translate korean f005_2_s2_end_5d432ad6:
    voice get_voice_filename("yuu", 165)
    # yuu "「……お姉ちゃん？」"
    yuu "「……누나?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_0339ede2 | scenario/005_2.rpy:3700
translate korean f005_2_s2_end_0339ede2:
    voice get_voice_filename("rnk", 820)
    # rinka "「牛塚さんを連れて行けはしないんだったら、君が説得して牛塚さんのご家族に来てもらうようにしないと」"
    rinka "「우시즈카 씨를 데려갈 수 없다면 네가 설득해서 우시즈카 씨 가족이 오게 해야 해」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_59d57193 | scenario/005_2.rpy:3705
translate korean f005_2_s2_end_59d57193:
    voice get_voice_filename("rnk")
    # rinka "「私はそこまでは協力できない――けど、自分を信じてね」"
    rinka "「나는 거기까지 도울 수는 없어――그래도 너 자신을 믿어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_93733636 | scenario/005_2.rpy:3710
translate korean f005_2_s2_end_93733636:
    voice get_voice_filename("yuu")
    # yuu "「ちょっとお姉ちゃん、どういうこと？」"
    yuu "「잠깐, 누나, 무슨 말이야?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_e792613b | scenario/005_2.rpy:3712
translate korean f005_2_s2_end_e792613b:
    # "だって、牛塚さんがその名を授けた通り、ユウくんは優しくて勇気がある子だったのだから。"
    "왜냐하면 우시즈카 씨가 그 이름을 지어 준 그대로 유우 군은 다정하고 용기 있는 아이였으니까."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_cb9c5f0c | scenario/005_2.rpy:3714
translate korean f005_2_s2_end_cb9c5f0c:
    # "戸惑うユウくんに、私は封筒を手渡した。"
    "당황하는 유우 군에게 나는 봉투를 건넸다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_afe7598b | scenario/005_2.rpy:3716
translate korean f005_2_s2_end_afe7598b:
    # "中には私が調べた牛塚さんの家族についての情報と、こっそり持って来たお金が入っている。"
    "안에는 내가 조사한 우시즈카 씨 가족에 관한 정보와 몰래 가져온 돈이 들어 있다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_1296439a | scenario/005_2.rpy:3721
translate korean f005_2_s2_end_1296439a:
    voice get_voice_filename("yuu")
    # yuu "「分かって……たの？」"
    yuu "「알고…… 있었어?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_3ffd13dc | scenario/005_2.rpy:3726
translate korean f005_2_s2_end_3ffd13dc:
    voice get_voice_filename("rnk")
    # rinka "「何となくだけど、私も同じことを考えてたから」"
    rinka "「어렴풋하게지만 나도 같은 생각을 하고 있었으니까」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_fe96fce5 | scenario/005_2.rpy:3728
translate korean f005_2_s2_end_fe96fce5:
    # "ここからは、ユウくんと牛塚さんの物語だ。"
    "이제부터는 유우 군과 우시즈카 씨의 이야기다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_c2712c93 | scenario/005_2.rpy:3730
translate korean f005_2_s2_end_c2712c93:
    # "その結末を、私は見届けようとは思わなかった。"
    "그 결말을 내가 지켜볼 생각은 없었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_76c5b3f1 | scenario/005_2.rpy:3732
translate korean f005_2_s2_end_76c5b3f1:
    # "ユウくんに可能性を託せたから、牛塚さんがたとえ脱落してしまっても、もう後悔はしないだろう。"
    "유우 군에게 가능성을 맡겼으니 우시즈카 씨가 설령 탈락하더라도 더는 후회하지 않겠지."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_a8ee1bb3 | scenario/005_2.rpy:3737
translate korean f005_2_s2_end_a8ee1bb3:
    voice get_voice_filename("yuu")
    # yuu "「おじいちゃんが、最期に笑っていられるように。ボク、頑張るよ」"
    yuu "「할아버지가 마지막에 웃을 수 있도록 나, 노력할게」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_31c327fd | scenario/005_2.rpy:3742
translate korean f005_2_s2_end_31c327fd:
    voice get_voice_filename("yuu")
    # yuu "「ありがとう、お姉ちゃん！　お金は絶対返すから！」"
    yuu "「고마워, 누나! 돈은 꼭 갚을게!」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_3311fd46 | scenario/005_2.rpy:3744
translate korean f005_2_s2_end_3311fd46:
    # "ユウくんは笑顔でそう言ったあと、少しの間動かなかった。"
    "유우 군은 웃으며 말한 뒤 잠시 움직이지 않았다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_eca3cc8b | scenario/005_2.rpy:3749
translate korean f005_2_s2_end_eca3cc8b:
    # "私が「そろそろ行くね」と声をかけようとしたとき、真剣な表情で「待って」と話し始めた。"
    "내가 「이제 가야겠다」고 말하려던 때 진지한 표정으로 「기다려」라고 말하기 시작했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_6555b9fa | scenario/005_2.rpy:3754
translate korean f005_2_s2_end_6555b9fa:
    voice get_voice_filename("yuu")
    # yuu "「もう一つお願いがあるんだ」"
    yuu "「한 가지 더 부탁이 있어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_1bcc0f61 | scenario/005_2.rpy:3756
translate korean f005_2_s2_end_1bcc0f61:
    # "神妙な表情は、明るい話題ではないことを示していた。"
    "심각한 표정은 밝은 이야기가 아님을 보여 주었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_b66024c8 | scenario/005_2.rpy:3758
translate korean f005_2_s2_end_b66024c8:
    # "ここからは、私が完全に予想外のことだった。"
    "여기서부터는 내가 전혀 예상하지 못한 일이었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_fbe66c17 | scenario/005_2.rpy:3766
translate korean f005_2_s2_end_fbe66c17:
    voice get_voice_filename("yuu")
    # yuu "「ボクを、脱落させて欲しい」"
    yuu "「나를 탈락시켜 줘」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_a5afaa0b | scenario/005_2.rpy:3771
translate korean f005_2_s2_end_a5afaa0b:
    voice get_voice_filename("rnk")
    # rinka "「えっ……」"
    rinka "「뭐……」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_8516be40 | scenario/005_2.rpy:3776
translate korean f005_2_s2_end_8516be40:
    voice get_voice_filename("yuu")
    # yuu "「お姉ちゃんがボクの≪カード≫を３枚持っていることは、察しがついてた」"
    yuu "「누나가 내 ≪카드≫를 ３장 가지고 있다는 건 짐작하고 있었어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_23c87257 | scenario/005_2.rpy:3781
translate korean f005_2_s2_end_23c87257:
    voice get_voice_filename("yuu")
    # yuu "「ただね、お姉ちゃんは優しいから、ボクを指名できないんじゃないかって思ってたんだ」"
    yuu "「그런데 누나는 다정하니까 나를 지명하지 못할 것 같았어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_54b27ef5 | scenario/005_2.rpy:3786
translate korean f005_2_s2_end_54b27ef5:
    voice get_voice_filename("rnk")
    # rinka "「……どうして？」"
    rinka "「……왜?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_653689e0 | scenario/005_2.rpy:3791
translate korean f005_2_s2_end_653689e0:
    voice get_voice_filename("yuu")
    # yuu "「お姉ちゃんに、生きて欲しいって思ったからなんだ」"
    yuu "「누나가 살아 줬으면 하니까」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_a10366bb | scenario/005_2.rpy:3796
translate korean f005_2_s2_end_a10366bb:
    voice get_voice_filename("rnk")
    # rinka "「そんなの！　……ごめん、大きな声出しちゃったね」"
    rinka "「그런 건! ……미안, 큰 소리 내 버렸네」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_69ee9f7b | scenario/005_2.rpy:3801
translate korean f005_2_s2_end_69ee9f7b:
    voice get_voice_filename("yuu")
    # yuu "「ボクは本気だよ。お姉ちゃんがボクを脱落させるなら、納得できるから」"
    yuu "「나는 진심이야. 누나가 나를 탈락시킨다면 납득할 수 있어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_90de4646 | scenario/005_2.rpy:3806
translate korean f005_2_s2_end_90de4646:
    voice get_voice_filename("yuu")
    # yuu "「それだけじゃない――ボクはきっと、生きてちゃいけないんだ」"
    yuu "「그뿐만이 아니야――나는 분명 살아서는 안 되는 사람이야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_5ba25c93 | scenario/005_2.rpy:3811
translate korean f005_2_s2_end_5ba25c93:
    voice get_voice_filename("rnk")
    # rinka "「生きてちゃ……いけない？」"
    rinka "「살아서는…… 안 된다고?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_1934a594 | scenario/005_2.rpy:3816
translate korean f005_2_s2_end_1934a594:
    voice get_voice_filename("yuu")
    # yuu "「ボクがなくした記憶は、全然戻る気はしないよ。でもね、時々自分が怖くなる」"
    yuu "「내가 잃은 기억은 전혀 돌아올 것 같지 않아. 그런데 가끔 내가 무서워져」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_d06f1f2e | scenario/005_2.rpy:3821
translate korean f005_2_s2_end_d06f1f2e:
    voice get_voice_filename("yuu")
    # yuu "「ボクの中にいるもう一人のボクが、何か怖ろしいことをしようとしている気がして……」"
    yuu "「내 안에 있는 또 다른 내가 무서운 일을 저지르려는 것 같아서……」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_29b81800 | scenario/005_2.rpy:3826
translate korean f005_2_s2_end_29b81800:
    voice get_voice_filename("yuu")
    # yuu "「もし記憶が戻ったら、ボクは何するか分からない。ボクがボクじゃなくなっちゃうかもしれない」"
    yuu "「기억이 돌아오면 내가 무슨 짓을 할지 몰라. 내가 내가 아니게 될지도 몰라」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_80e3c013 | scenario/005_2.rpy:3831
translate korean f005_2_s2_end_80e3c013:
    voice get_voice_filename("yuu")
    # yuu "「だから！　その前にボクを殺して！」"
    yuu "「그러니까! 그러기 전에 나를 죽여 줘!」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_7f5773c2 | scenario/005_2.rpy:3833
translate korean f005_2_s2_end_7f5773c2:
    # "ユウくんは追い詰められたような声でそう告げた。"
    "유우 군은 궁지에 몰린 듯한 목소리로 말했다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_df9a73ca | scenario/005_2.rpy:3835
translate korean f005_2_s2_end_df9a73ca:
    # "心の中にいる自分の知らない自分が、ユウくんを追い詰めているのだろう。"
    "마음속에 있는 자신도 모르는 자신이 유우 군을 궁지로 몰고 있는 것이리라."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_c87ae67f | scenario/005_2.rpy:3837
translate korean f005_2_s2_end_c87ae67f:
    # "彼の言う通り、私は今週の選定ではユウくんを指名するつもりはなかった。"
    "그의 말대로 나는 이번 주 선정에서 유우 군을 지명할 생각이 없었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_c28aaab5 | scenario/005_2.rpy:3839
translate korean f005_2_s2_end_c28aaab5:
    # "まだその覚悟はできていなかったのだ。"
    "아직 그럴 각오가 되지 않았다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_333781a5 | scenario/005_2.rpy:3844
translate korean f005_2_s2_end_333781a5:
    voice get_voice_filename("rnk")
    # rinka "「……ごめん、即答はできない」"
    rinka "「……미안, 바로 대답할 수 없어」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_2da7e5cf | scenario/005_2.rpy:3849
translate korean f005_2_s2_end_2da7e5cf:
    voice get_voice_filename("yuu")
    # yuu "「どうして？　お姉ちゃんが生きたいんだったら、いずれはボクのことも脱落させるはずでしょ？」"
    yuu "「왜? 누나가 살고 싶다면 언젠가는 나도 탈락시킬 거잖아?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_4d768683 | scenario/005_2.rpy:3854
translate korean f005_2_s2_end_4d768683:
    voice get_voice_filename("rnk")
    # rinka "「そうだよ。でも、もしユウくんを脱落させるとしたら、それはユウくんの記憶が戻ってから。真実が、分かってから。ユウくんは記憶喪失で、不安になっているだけなんじゃないかな？」"
    rinka "「맞아. 하지만 만약 유우 군을 탈락시킨다면 그건 기억이 돌아온 뒤야. 진실을 알게 된 뒤. 유우 군은 기억상실이라서 불안한 것뿐 아닐까?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_c515b00b | scenario/005_2.rpy:3859
translate korean f005_2_s2_end_c515b00b:
    voice get_voice_filename("rnk")
    # rinka "「何も分からないままユウくんが脱落したら、私は後悔するかもしれない」"
    rinka "「아무것도 모르는 채 유우 군이 탈락하면 내가 후회할지도 몰라」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_7d59f9fe | scenario/005_2.rpy:3864
translate korean f005_2_s2_end_7d59f9fe:
    voice get_voice_filename("yuu")
    # yuu "「駄目だよ！」"
    yuu "「안 돼!」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_78831d3d | scenario/005_2.rpy:3866
translate korean f005_2_s2_end_78831d3d:
    # "それでも、ユウくんは食い下がる。"
    "그래도 유우 군은 물러서지 않는다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_f1c2cea1 | scenario/005_2.rpy:3868
translate korean f005_2_s2_end_f1c2cea1:
    # "私の性格を知っているだろうに、彼はまるで気にせず続けた。"
    "내 성격을 알 텐데도 그는 전혀 개의치 않고 말을 이었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_8a3077bb | scenario/005_2.rpy:3873
translate korean f005_2_s2_end_8a3077bb:
    voice get_voice_filename("yuu")
    # yuu "「お願いだから――優しいお姉ちゃんなら、聞いてくれるよね？」"
    yuu "「부탁이니까――다정한 누나라면 들어줄 거지?」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_7d09ed44 | scenario/005_2.rpy:3875
translate korean f005_2_s2_end_7d09ed44:
    # "その質問に、私は答えることはできなかった。"
    "그 질문에 나는 대답할 수 없었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_d26bf670 | scenario/005_2.rpy:3877
translate korean f005_2_s2_end_d26bf670:
    # "ユウくんは大きな瞳でずっと、私を見つめている。"
    "유우 군은 커다란 눈으로 계속 나를 바라본다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_92f84e92 | scenario/005_2.rpy:3879
translate korean f005_2_s2_end_92f84e92:
    # "彼が怖ろしいことをする――そんなことを言われても、信じられない。"
    "그가 무서운 일을 한다――그런 말을 들어도 믿기지 않는다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_59b13615 | scenario/005_2.rpy:3881
translate korean f005_2_s2_end_59b13615:
    # "戦い方を知らざるをえないような過去を持っているのかもしれないけれど、だからと言って彼の抱える不安とは繋がらない。"
    "싸우는 법을 배울 수밖에 없었던 과거가 있을지 모르지만 그렇다고 그의 불안과 이어지는 건 아니다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_14edc750 | scenario/005_2.rpy:3886
translate korean f005_2_s2_end_14edc750:
    voice get_voice_filename("yuu")
    # yuu "「絶対だよ」"
    yuu "「꼭이야」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_f3366eac | scenario/005_2.rpy:3890
translate korean f005_2_s2_end_f3366eac:
    # "返事のできない私に痺れを切らしたのか、ユウくんは短くそう言い残し、乗換ホームへと去っていった。"
    "대답하지 못하는 내게 인내심이 바닥났는지 유우 군은 짧게 그 말을 남기고 환승 승강장으로 떠났다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_09af243c | scenario/005_2.rpy:3892
translate korean f005_2_s2_end_09af243c:
    # "彼にはっきりとした返事ができなかったのは、私の中で答えは決まっていたからだ。"
    "그에게 확실히 대답하지 못한 건 내 안에서 답이 정해져 있었기 때문이다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_015c723c | scenario/005_2.rpy:3894
translate korean f005_2_s2_end_015c723c:
    # "――今はまだ、できないと。"
    "――지금은 아직 할 수 없다고."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_8892b024 | scenario/005_2.rpy:3919
translate korean f005_2_s2_end_8892b024:
    # "日曜日は久々に、終日お店を開けていた。"
    "일요일은 오랜만에 하루 종일 가게 문을 열었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_10a9632e | scenario/005_2.rpy:3921
translate korean f005_2_s2_end_10a9632e:
    # "ここ最近は休みがちだったため、ちょっとなまってしまったのだろう、足が疲れてしまった。"
    "요즘 자주 쉬어서 몸이 좀 둔해진 걸까, 다리가 피곤해졌다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_7df33646 | scenario/005_2.rpy:3923
translate korean f005_2_s2_end_7df33646:
    # "それでも、労働の汗を流すのは気持ちいい。"
    "그래도 일하며 흘린 땀을 씻어 내는 건 기분 좋다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_ade73533 | scenario/005_2.rpy:3925
translate korean f005_2_s2_end_ade73533:
    # "ライオン館でくつろいでいるお客さんの顔を見ていると、充実感もある。"
    "라이온관에서 쉬는 손님들의 얼굴을 보고 있으면 보람도 느껴진다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_8e1cb9d7 | scenario/005_2.rpy:3930
translate korean f005_2_s2_end_8e1cb9d7:
    voice get_voice_filename("rnk")
    # rinka "「よし、シャワーを浴びて早く寝よう」"
    rinka "「좋아, 샤워하고 일찍 자자」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_7ad6ba1b | scenario/005_2.rpy:3932
translate korean f005_2_s2_end_7ad6ba1b:
    # "今日は、女神の選定。"
    "오늘은 여신의 선정."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_e0c6dbd2 | scenario/005_2.rpy:3934
translate korean f005_2_s2_end_e0c6dbd2:
    # "何時に寝たって関係はないのだけれど、睡眠時間は多い方が、明日の寝起きはマシなはずだ。"
    "몇 시에 자든 상관없지만 수면 시간은 긴 편이 내일 아침 일어나기 나을 것이다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_ecb4a6a3 | scenario/005_2.rpy:3941
translate korean f005_2_s2_end_ecb4a6a3:
    # "シャワーを浴びて部屋へ戻ると、丸くって黒い塊が部屋にあった。"
    "샤워하고 방으로 돌아오자 둥글고 검은 덩어리가 방에 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_1d617eb5 | scenario/005_2.rpy:3943
translate korean f005_2_s2_end_1d617eb5:
    # "黒猫のレテが、ふてぶてしい態度でベッドの上にいた。"
    "검은 고양이 레테가 뻔뻔한 태도로 침대 위에 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_5eeb74ab | scenario/005_2.rpy:3948
translate korean f005_2_s2_end_5eeb74ab:
    voice get_voice_filename("rnk")
    # rinka "「もう……」"
    rinka "「정말……」"

# scenario.rpa::scenario/005_2.rpy::tid::f005_2_s2_end_83a895a3 | scenario/005_2.rpy:3950
translate korean f005_2_s2_end_83a895a3:
    # "口ではそう言いつつも、一人じゃないことが心強かった。"
    "말로는 그렇게 하면서도 혼자가 아니라는 사실이 든든했다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_b00e7fa4 | scenario/005_2.rpy:3985
translate korean sentei5_b00e7fa4:
    voice get_voice_filename("dia", 114)
    # parca "「ごきげんよう。運命の奴隷の皆サマ」"
    parca "「안녕하신지요. 운명의 노예 여러분」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_8df752ba | scenario/005_2.rpy:3987
translate korean sentei5_8df752ba:
    # "女神の声が、運命の大広間に響く。"
    "여신의 목소리가 운명의 대회랑에 울렸다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_a5427fb8 | scenario/005_2.rpy:3989
translate korean sentei5_a5427fb8:
    # "私は今夜も、女神の選定の場へと来ていた。"
    "오늘 밤도 나는 여신의 선정이 열리는 곳에 와 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_e9d01d02 | scenario/005_2.rpy:3993
translate korean sentei5_e9d01d02:
    voice get_voice_filename("sgt", 260)
    # ushizuka "「ほっほ。録画をせんでも毎週忘れることがないから楽じゃのう」"
    ushizuka "「허허. 녹화하지 않아도 매주 잊을 일이 없으니 편하구먼」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_ba34768f | scenario/005_2.rpy:3998
translate korean sentei5_ba34768f:
    voice get_voice_filename("dia")
    # parca "「あらおじいサマ？　テレビ番組のようにおっしゃらないでくださいます？」"
    parca "「어머, 할아버님? 텔레비전 방송처럼 말씀하지 말아 주시겠어요?」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_db93814e | scenario/005_2.rpy:4002
translate korean sentei5_db93814e:
    voice get_voice_filename("sgt")
    # ushizuka "「女神様もテレビのことは知っておったんじゃのう」"
    ushizuka "「여신님도 텔레비전을 알고 계셨구먼」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_68272483 | scenario/005_2.rpy:4007
translate korean sentei5_68272483:
    voice get_voice_filename("dia")
    # parca "「ワタクシはこれでも、浮世の流行には敏感なのでございますわ」"
    parca "「저는 이래 보여도 속세의 유행에 민감하답니다」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_6bd5b83c | scenario/005_2.rpy:4012
translate korean sentei5_6bd5b83c:
    voice get_voice_filename("dia")
    # parca "「時の移ろいから外れた存在のワタクシですけれど、無為に過ごすには退屈過ぎますもの」"
    parca "「시간의 흐름에서 벗어난 존재인 저지만 무위로 지내기에는 너무 따분한걸요」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_f58a454d | scenario/005_2.rpy:4014
translate korean sentei5_f58a454d:
    # "女神は牛塚さんに対し、微笑みながらそう答えていた。"
    "여신은 우시즈카 씨에게 미소 지으며 그렇게 대답했다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_b6500664 | scenario/005_2.rpy:4016
translate korean sentei5_b6500664:
    # "ファンタジー世界の登場人物のような彼女からテレビという言葉が出るのは、とても違和感があった。"
    "판타지 세계 등장인물 같은 그녀 입에서 텔레비전이라는 말이 나오니 몹시 위화감이 들었다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_360316d5 | scenario/005_2.rpy:4018
translate korean sentei5_360316d5:
    # "上位の存在である彼女は、夢の世界から私たちの世界を全て監視でもしているのだろうか。"
    "상위 존재인 그녀는 꿈의 세계에서 우리 세계 전부를 감시라도 하는 걸까."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_f673b3e9 | scenario/005_2.rpy:4023
translate korean sentei5_f673b3e9:
    voice get_voice_filename("dia")
    # parca "「皆サマ、そろそろお疲れのご様子ですね。選定も中盤……無理もありませんね」"
    parca "「여러분, 슬슬 피곤해 보이시네요. 선정도 중반…… 무리는 아니지요」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_cb9fe021 | scenario/005_2.rpy:4027
translate korean sentei5_cb9fe021:
    voice get_voice_filename("fed", 140)
    # federico "「おいおい、とっとと始めてくれないか？　あんたの言う通り確かに疲れてるから、睡眠時間は確保したいんだよ」"
    federico "「이봐, 빨리 시작해 주면 안 되나? 당신 말대로 확실히 피곤하니까 잠잘 시간은 확보하고 싶다고」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_e7fb747b | scenario/005_2.rpy:4029
translate korean sentei5_e7fb747b:
    # "海晴の隣から、Ⅲのカルミナーティさんがおどけた口調でそう言った。"
    "미하루의 옆에서 Ⅲ의 카르미나티 씨가 능청스러운 말투로 그렇게 말했다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_96a8afc4 | scenario/005_2.rpy:4031
translate korean sentei5_96a8afc4:
    # "彼を見ると、特に怪我などはしていないようだ。"
    "그를 보니 특별히 다친 곳은 없어 보인다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_ae005fdf | scenario/005_2.rpy:4033
translate korean sentei5_ae005fdf:
    # "ユウくんは彼にしばらく動けない怪我を負わせたと言っていたが、勘違いだったのか。"
    "유우 군은 그에게 한동안 움직이지 못할 부상을 입혔다고 했지만 착각이었을까."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_991e5046 | scenario/005_2.rpy:4035
translate korean sentei5_991e5046:
    # "あるいは、夢の世界では現実世界の体調は影響しない……か。"
    "아니면 꿈의 세계에서는 현실 몸 상태가 영향을 끼치지 않는…… 건가."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_baf9bf58 | scenario/005_2.rpy:4037
translate korean sentei5_baf9bf58:
    # "とすれば、彼が健康に振舞うことは怪我をしていることのカムフラージュにもなる。"
    "그렇다면 그가 건강한 척하는 건 다쳤다는 사실을 감추는 위장도 된다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_81811ee2 | scenario/005_2.rpy:4042
translate korean sentei5_81811ee2:
    voice get_voice_filename("dia")
    # parca "「全くもうっ。皆サマはせっかちさんで嫌になりますわ。ワタクシの退屈をもっと紛らわせてくださってもよろしいのに」"
    parca "「정말이지. 여러분은 성급해서 싫증난다니까요. 제 지루함을 조금 더 달래 주셔도 좋을 텐데」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_7ebfe3cf | scenario/005_2.rpy:4047
translate korean sentei5_7ebfe3cf:
    voice get_voice_filename("dia")
    # parca "「まあ、仕方がないと致しましょう。今宵を含め、≪女神の選定≫はまだ８回も残っているのですから」"
    parca "「뭐, 어쩔 수 없지요. 오늘 밤을 포함해 ≪여신의 선정≫은 아직 ８번이나 남았으니까요」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_0420657a | scenario/005_2.rpy:4053
translate korean sentei5_0420657a:
    voice get_voice_filename("dia")
    # parca "「それでは、今宵も女神の選定を始めますわ」"
    parca "「그럼 오늘 밤도 여신의 선정을 시작하겠습니다」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_819007c4 | scenario/005_2.rpy:4057
translate korean sentei5_819007c4:
    voice get_voice_filename("dia")
    # parca "「廻りなさい。運命の大時計」"
    parca "「돌아가세요. 운명의 대시계」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_ce5346c3 | scenario/005_2.rpy:4062
translate korean sentei5_ce5346c3:
    # "その後は、いつもと同じ流れだ。"
    "그 뒤는 언제나와 같은 흐름이다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_eb4896cb | scenario/005_2.rpy:4064
translate korean sentei5_eb4896cb:
    # "時計が回り、順番に指名の意志確認を行っていく。"
    "시계가 돌고 차례대로 지명 의사를 확인한다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_84a69bf0 | scenario/005_2.rpy:4066
translate korean sentei5_84a69bf0:
    # "Ⅰ番の私は、当然最初に聞かれる。"
    "Ⅰ번인 나는 당연히 가장 먼저 질문을 받는다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_708c2a29 | scenario/005_2.rpy:4068
translate korean sentei5_708c2a29:
    # "今夜も、私は指名を行わない宣言をした。"
    "오늘 밤도 나는 지명하지 않겠다고 선언했다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_64bed89d | scenario/005_2.rpy:4070
translate korean sentei5_64bed89d:
    # "さらに順番に時計は回り、今夜氏名を行うのは結局Ⅻのアランさん一人だ。"
    "계속 차례대로 시계가 돌고 오늘 밤 지명하는 사람은 결국 Ⅻ의 아란 씨 한 명이다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_899fe040 | scenario/005_2.rpy:4077
translate korean sentei5_899fe040:
    voice get_voice_filename("aln", 158)
    # alan "「僕は、“Ⅴ”を指名させてもらおう」"
    alan "「나는 “Ⅴ”를 지명하겠다」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_06e67762 | scenario/005_2.rpy:4079
translate korean sentei5_06e67762:
    # "あらかじめ分かっていた通り、Ⅴの牛塚さんを指名した。"
    "미리 알고 있던 대로 Ⅴ의 우시즈카 씨를 지명했다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_93ff54ae | scenario/005_2.rpy:4083
translate korean sentei5_93ff54ae:
    # "牛塚さんは満足そうな表情を浮かべていた。"
    "우시즈카 씨는 만족스러운 표정을 지었다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_52ab1f87 | scenario/005_2.rpy:4085
translate korean sentei5_52ab1f87:
    # "その裏にどんな想いがあるのか推し測ることしかできなかったけれど、きっと彼らの物語は悪い結末ではなかったのだろう。"
    "그 뒤에 어떤 마음이 있는지는 헤아릴 수밖에 없었지만 분명 그들의 이야기는 나쁜 결말이 아니었으리라."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_833a2b24 | scenario/005_2.rpy:4087
translate korean sentei5_833a2b24:
    # "それよりも。"
    "그보다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_25d5f666 | scenario/005_2.rpy:4095
translate korean sentei5_25d5f666:
    voice get_voice_filename("yuu", 185)
    # yuu "「――どうして。お姉ちゃんの、嘘つき」"
    yuu "「――왜. 누나, 거짓말쟁이」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_14315fba | scenario/005_2.rpy:4097
translate korean sentei5_14315fba:
    # "夢の世界に虚しく漂う彼の呟きへ、私は罪悪感を抱いていた。"
    "꿈의 세계에 허무하게 떠도는 그의 중얼거림에 나는 죄책감을 느꼈다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_9fc0eeec | scenario/005_2.rpy:4111
translate korean sentei5_9fc0eeec:
    # "運命の大広間の上層で、青年と老人が向かい合っていた。"
    "운명의 대회랑 위층에서 청년과 노인이 마주 보고 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_6f1281d5 | scenario/005_2.rpy:4113
translate korean sentei5_6f1281d5:
    # "アランと茂継だ。"
    "아란과 시게쓰구다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_511802df | scenario/005_2.rpy:4115
translate korean sentei5_511802df:
    # "すでに３回目の指名となる彼は、この空間に来ても前２回と同じように表情を変えることはなかった。"
    "이미 ３번째 지명을 받은 그는 이 공간에 와서도 앞선 ２번과 마찬가지로 표정이 변하지 않았다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_45ac72de | scenario/005_2.rpy:4122
translate korean sentei5_45ac72de:
    voice get_voice_filename("sgt")
    # ushizuka "「ほう、すごいのう。夢の世界とやらはこんな風になっておったのか」"
    ushizuka "「오, 대단하구먼. 꿈의 세계라는 건 이런 모습이었나」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_66cdf7b6 | scenario/005_2.rpy:4126
translate korean sentei5_66cdf7b6:
    # "茂継に対し、アランは何も言わなかった。"
    "시게쓰구에게 아란은 아무 말도 하지 않았다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_2da411c3 | scenario/005_2.rpy:4128
translate korean sentei5_2da411c3:
    # "感情の読めない瞳で、老人のしわくちゃの笑顔をとらえている。"
    "감정을 읽을 수 없는 눈으로 노인의 주름진 웃는 얼굴을 바라보고 있다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_29a55d2f | scenario/005_2.rpy:4133
translate korean sentei5_29a55d2f:
    voice get_voice_filename("dia")
    # parca "「貴方サマはすっかり常連ですわね」"
    parca "「당신은 완전히 단골이시네요」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_64f5e6b4 | scenario/005_2.rpy:4135
translate korean sentei5_64f5e6b4:
    # "いきなり姿を見せた女神に対して、アランは何も答えない。"
    "갑자기 나타난 여신에게 아란은 아무 대답도 하지 않는다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_e66a60e0 | scenario/005_2.rpy:4140
translate korean sentei5_e66a60e0:
    voice get_voice_filename("dia")
    # parca "「ワタクシも、貴方サマがつれないお方だというのは分かっていますわ」"
    parca "「저도 당신이 쌀쌀맞은 분이라는 건 알고 있답니다」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_47efe51c | scenario/005_2.rpy:4145
translate korean sentei5_47efe51c:
    voice get_voice_filename("dia")
    # parca "「それでは、３枚のカードをお選びくださいませ」"
    parca "「그럼 ３장의 카드를 골라 주십시오」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_d35fd5bb | scenario/005_2.rpy:4152
translate korean sentei5_d35fd5bb:
    # "アランは開かれたカードブックから、３枚のカードに触れ、選び取る。"
    "아란은 펼쳐진 카드북에서 ３장의 카드에 손을 대 골랐다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_5b80787e | scenario/005_2.rpy:4154
translate korean sentei5_5b80787e:
    # "そして、その内容を淡々と読み上げた。"
    "그리고 그 내용을 담담히 읽어 내렸다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_7f12aee0 | scenario/005_2.rpy:4158
translate korean sentei5_7f12aee0:
    voice get_voice_filename("aln")
    # alan "「氏名、牛塚茂継。死因、餓死。未練……仲の良かった家族」"
    alan "「성명, 우시즈카 시게쓰구. 사인, 아사. 미련…… 사이좋았던 가족」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_34f21a63 | scenario/005_2.rpy:4162
translate korean sentei5_34f21a63:
    voice get_voice_filename("sgt")
    # ushizuka "「ほっほ、とはいえ、わしはもう思い残すことはないがのう」"
    ushizuka "「허허, 그렇지만 나는 이제 아무 미련도 없다만」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_ef604a8b | scenario/005_2.rpy:4170
translate korean sentei5_ef604a8b:
    voice get_voice_filename("sgt")
    # ushizuka "「どんなからくりを使ったかは知れんが、わしの息子たち一家と会わせてくれおった」"
    ushizuka "「무슨 수를 썼는지는 모르겠지만 내 아들네 가족과 만나게 해 줬거든」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_da5a4632 | scenario/005_2.rpy:4175
translate korean sentei5_da5a4632:
    voice get_voice_filename("aln")
    # alan "「何を言う」"
    alan "「무슨 소리냐」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_eacbd5d2 | scenario/005_2.rpy:4180
translate korean sentei5_eacbd5d2:
    voice get_voice_filename("aln")
    # alan "「からくりではないだろう。彼――貴様の家族からの冥途の土産だろう？　そう言ってやらなければ、報われない」"
    alan "「수작이 아니겠지. 그――네 가족이 주는 저승길 선물이잖아? 그렇게 말해 주지 않으면 보람이 없지」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_ff721462 | scenario/005_2.rpy:4185
translate korean sentei5_ff721462:
    voice get_voice_filename("sgt")
    # ushizuka "「ほっほ、分かっておるよ。老人の照れ隠しじゃ」"
    ushizuka "「허허, 알고 있어. 늙은이의 쑥스러움 감추기다」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_10fdb920 | scenario/005_2.rpy:4190
translate korean sentei5_10fdb920:
    voice get_voice_filename("aln")
    # alan "「……そうか」"
    alan "「……그런가」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_2576fba9 | scenario/005_2.rpy:4195
translate korean sentei5_2576fba9:
    voice get_voice_filename("sgt")
    # ushizuka "「意外じゃのう。いや、意外でもないか。短い付き合いじゃったが分かる。おぬしは――誰よりも家族想いじゃとな」"
    ushizuka "「의외구먼. 아니, 의외도 아닌가. 짧은 인연이었지만 알 수 있어. 너는――누구보다도 가족을 아끼는 사람이라고」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_b50b548c | scenario/005_2.rpy:4200
translate korean sentei5_b50b548c:
    voice get_voice_filename("aln")
    # alan "「……フン。余計な話をし過ぎた。女神、もういいだろう？」"
    alan "「……흥. 쓸데없는 말을 너무 많이 했다. 여신, 이제 됐지?」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_17fcdd89 | scenario/005_2.rpy:4205
translate korean sentei5_17fcdd89:
    voice get_voice_filename("dia")
    # parca "「あら、もうよろしいのですか？」"
    parca "「어머, 벌써 괜찮으신가요?」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_350959f1 | scenario/005_2.rpy:4209
translate korean sentei5_350959f1:
    # "パルカの問いかけにアランが答える前に、アランの取り出したカードを中心として白い光が広がり始める。"
    "파르카의 질문에 아란이 대답하기 전에 아란이 꺼낸 카드를 중심으로 하얀 빛이 퍼지기 시작한다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_25ff8c3d | scenario/005_2.rpy:4213
translate korean sentei5_25ff8c3d:
    # "光は一瞬で、この空間を覆いつくした。"
    "빛은 순식간에 이 공간을 뒤덮었다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_19492576 | scenario/005_2.rpy:4233
translate korean sentei5_19492576:
    # "孤独であった。"
    "외로웠다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_f6bca82d | scenario/005_2.rpy:4235
translate korean sentei5_f6bca82d:
    # "自宅の床。"
    "자택 바닥."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_7c516cdd | scenario/005_2.rpy:4237
translate korean sentei5_7c516cdd:
    # "布団ですらない剥き出しの畳の上で、空腹に爛れた思考で過去を見る。"
    "이불조차 아닌 맨 다다미 위에서 굶주림에 문드러진 생각으로 과거를 본다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_424ad699 | scenario/005_2.rpy:4239
translate korean sentei5_424ad699:
    # "あの頃をもう一度。"
    "그 시절을 다시 한번."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_d64df65d | scenario/005_2.rpy:4241
translate korean sentei5_d64df65d:
    # "叶わぬ夢が彼の脳裏に焼き付いたまま、命の灯は消えていく。"
    "이루지 못할 꿈이 그의 뇌리에 새겨진 채 생명의 불꽃은 꺼져 간다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_7ac1e095 | scenario/005_2.rpy:4257
translate korean sentei5_7ac1e095:
    voice get_voice_filename("aln")
    # alan "「同情もしない。もっとも、貴様の場合は最期に夢を見たのだ――十分だろう」"
    alan "「동정하지도 않겠다. 그래도 너는 마지막에 꿈을 꾸었어――그걸로 충분하겠지」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_0c6ad9be | scenario/005_2.rpy:4262
translate korean sentei5_0c6ad9be:
    voice get_voice_filename("dia")
    # parca "「やはり珍しいですわね。貴方サマが少しでも感傷をお見せになるなんて」"
    parca "「역시 드문 일이네요. 당신이 조금이나마 감상을 드러내시다니」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_755bf16a | scenario/005_2.rpy:4267
translate korean sentei5_755bf16a:
    voice get_voice_filename("aln")
    # alan "「余計な話はいいと言っているはずだ。貴様は貴様の仕事をしてくれ」"
    alan "「쓸데없는 이야기는 됐다고 했을 텐데. 너는 네 일을 해」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_ce6d385f | scenario/005_2.rpy:4272
translate korean sentei5_ce6d385f:
    voice get_voice_filename("dia")
    # parca "「まこと、面白味のない方ですわね。もっとも――もう幾度かすれば、貴方サマの興味深いところが見られるかもしれませんけれど」"
    parca "「정말 재미없는 분이네요. 다만――몇 번 더 지나면 당신의 흥미로운 모습을 볼 수 있을지도 모르지만요」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_26c2c292 | scenario/005_2.rpy:4274
translate korean sentei5_26c2c292:
    # "アランの乗った床が動き出し、茂継の持っていたカードが彼の前に展開される。"
    "아란이 탄 바닥이 움직이기 시작하고 시게쓰구가 가지고 있던 카드가 그의 앞에 펼쳐진다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_2d3bbcd6 | scenario/005_2.rpy:4276
translate korean sentei5_2d3bbcd6:
    # "下層に戻る前に、彼はどのカードを取得するのか決める必要があるのだ。"
    "아래층으로 돌아가기 전에 어떤 카드를 얻을지 정해야 한다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_9b6e8198 | scenario/005_2.rpy:4278
translate korean sentei5_9b6e8198:
    # "アランは相変わらずの無表情で、カードを選び始めた。"
    "아란은 여전히 무표정한 채 카드를 고르기 시작했다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_47bb7527 | scenario/005_2.rpy:4297
translate korean sentei5_47bb7527:
    # "しばらくして、アランさん一人だけが戻って来た。"
    "잠시 뒤 아란 씨 혼자 돌아왔다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_79055220 | scenario/005_2.rpy:4304
translate korean sentei5_79055220:
    voice get_voice_filename("dia")
    # parca "「それでは、どのカードを選びますか？」"
    parca "「그럼 어떤 카드를 고르시겠어요?」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_aa78708f | scenario/005_2.rpy:4309
translate korean sentei5_aa78708f:
    voice get_voice_filename("aln")
    # alan "「≪Ⅳ・未練≫のカードをもらおう」"
    alan "「≪Ⅳ・미련≫ 카드를 받겠다」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_6303f8d8 | scenario/005_2.rpy:4316
translate korean sentei5_6303f8d8:
    voice get_voice_filename("yuu")
    # yuu "「…………」"
    yuu "「…………」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_a9fa7570 | scenario/005_2.rpy:4321
translate korean sentei5_a9fa7570:
    # "様子がおかしい、と思っていた。"
    "상태가 이상하다고 생각했다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_f91fed2a | scenario/005_2.rpy:4323
translate korean sentei5_f91fed2a:
    # "ユウくんは、アランさんが自分のカードを宣言しても表情一つ変えはしなかった。"
    "유우 군은 아란 씨가 자신의 카드를 선언해도 표정 하나 변하지 않았다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_3b0a54d2 | scenario/005_2.rpy:4325
translate korean sentei5_3b0a54d2:
    # "いや、それよりも。"
    "아니, 그보다도."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_d147968b | scenario/005_2.rpy:4327
translate korean sentei5_d147968b:
    # "彼の顔つきは明らかに、たった数分前と異なっていた。"
    "그의 얼굴은 분명 불과 몇 분 전과 달랐다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_ff814938 | scenario/005_2.rpy:4329
translate korean sentei5_ff814938:
    # "その表情に、ぞくりと悪寒が走る。"
    "그 표정에 오싹한 한기가 내달렸다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_6f90f1e2 | scenario/005_2.rpy:4331
translate korean sentei5_6f90f1e2:
    # "彼はアランさんよりも、私の方を見ていたのだ。"
    "그는 아란 씨보다 나를 보고 있었다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_96ccb2b2 | scenario/005_2.rpy:4340
translate korean sentei5_96ccb2b2:
    voice get_voice_filename("mhr", 280)
    # miharu "「あの子は……」"
    miharu "「저 아이는……」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_68ad7d4e | scenario/005_2.rpy:4342
translate korean sentei5_68ad7d4e:
    # "私が彼を指名しなかったことに対して怒っている――それだけにはとても思えなかった。"
    "내가 그를 지명하지 않은 데 화가 난다――그뿐이라고는 도저히 생각되지 않았다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_3a07de6e | scenario/005_2.rpy:4344
translate korean sentei5_3a07de6e:
    # "もっと異質な、たとえるなら底無し沼を覗くような錯覚をするような、そんな目をしていた。"
    "더 이질적인, 비유하자면 밑 없는 늪을 들여다보는 착각이 들 듯한 눈이었다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_8aa0e849 | scenario/005_2.rpy:4349
translate korean sentei5_8aa0e849:
    voice get_voice_filename("rnk", 832)
    # rinka "「たっ……！」"
    rinka "「아……!」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_5faabcc3 | scenario/005_2.rpy:4351
translate korean sentei5_5faabcc3:
    # "夢の世界にもかかわらず、頭の奥に痛みを感じる。"
    "꿈의 세계인데도 머릿속 깊은 곳에 통증을 느꼈다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_41145374 | scenario/005_2.rpy:4353
translate korean sentei5_41145374:
    # "立っていられない程ではないので、精一杯堪えていた。"
    "서 있지 못할 정도는 아니라 온 힘을 다해 견뎠다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_5d92ae28 | scenario/005_2.rpy:4363
translate korean sentei5_5d92ae28:
    voice get_voice_filename("aln")
    # alan "「何っ……？」"
    alan "「뭐라고……?」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_8d5a751a | scenario/005_2.rpy:4365
translate korean sentei5_8d5a751a:
    # "アランさんがカードを手にしたとき、私は彼が心から動揺している姿を見た。"
    "아란 씨가 카드를 손에 넣었을 때 나는 그가 진심으로 동요하는 모습을 보았다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_4d590602 | scenario/005_2.rpy:4367
translate korean sentei5_4d590602:
    # "白く光っていたカードが、まるでガラスが割れるように破壊されたのだ。"
    "하얗게 빛나던 카드가 마치 유리가 깨지듯 부서졌다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_5c65490f | scenario/005_2.rpy:4369
translate korean sentei5_5c65490f:
    # "飛び散った破片は、光の粒になって霧散する。"
    "흩어진 파편은 빛 알갱이가 되어 사라졌다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_3d8ff986 | scenario/005_2.rpy:4377
translate korean sentei5_3d8ff986:
    voice get_voice_filename("dia")
    # parca "「あら、あらあらあら」"
    parca "「어머, 어머어머어머」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_85c3fb28 | scenario/005_2.rpy:4379
translate korean sentei5_85c3fb28:
    # "私の本も光を帯びたが、そのことに気付いたときには女神が次の言葉を口にしていた。"
    "내 책도 빛을 띠었지만 그걸 알아차렸을 때는 여신이 다음 말을 꺼낸 뒤였다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_37d27f40 | scenario/005_2.rpy:4384
translate korean sentei5_37d27f40:
    voice get_voice_filename("dia")
    # parca "「それでは、今宵の脱落者は１名。これをもって、選定を終了といたしましょう」"
    parca "「그럼 오늘 밤 탈락자는 １명. 이것으로 선정을 마치겠습니다」"

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_5f263963 | scenario/005_2.rpy:4386
translate korean sentei5_5f263963:
    # "不協和音はすでに、響き始めている。"
    "불협화음은 이미 울리기 시작했다."

# scenario.rpa::scenario/005_2.rpy::tid::sentei5_7c1283f2 | scenario/005_2.rpy:4388
translate korean sentei5_7c1283f2:
    # "私はまだ、その発端に触れたに過ぎなかった――。"
    "나는 아직 그 발단에 닿았을 뿐이었다――."

translate korean strings:

    # scenario.rpa::scenario/005_2.rpy::menu::002:prompt:01:233fc4d7a5744ff1 | scenario/005_2.rpy:3189
    old "海晴も今日はバイトが入っているらしいが……。"
    new "미하루도 오늘은 아르바이트가 있는 모양인데……."

    # scenario.rpa::scenario/005_2.rpy::menu::002:choice:02:7fc7414dc4e4fdbf | scenario/005_2.rpy:3190
    old "「一人で帰る」"
    new "「혼자 돌아간다」"

    # scenario.rpa::scenario/005_2.rpy::menu::002:choice:03:b2ef2b072059d2d8 | scenario/005_2.rpy:3198
    old "「一緒に帰る」"
    new "「함께 돌아간다」"
