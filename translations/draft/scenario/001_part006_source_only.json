  "entries": [
    {
      "stable_id": "scenario/001.rpy::L2014",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2014,
      "speaker": "narrator",
      "source_jp": "女性は、私にホテルの場所を訊いてきた。新宿方面にあるホテルのようなので、行き過ぎですよ、と教えてあげる。",
      "draft_ko": "여자는 내게 호텔 위치를 물었다. 신주쿠 쪽에 있는 호텔인 듯해서, 너무 지나쳐 왔다고 알려 주었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2024",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2024,
      "speaker": "narrator",
      "source_jp": "どうやら彼女は日本の寺を巡るため一人で日本に来たらしい。日本語が分からず困っていた、ありがとうとお礼を言ってくれた。",
      "draft_ko": "아무래도 그녀는 일본의 절을 둘러보기 위해 혼자 일본에 온 모양이다. 일본어를 몰라 곤란했는데 고맙다며 인사를 건넸다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2028",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2028,
      "speaker": "narrator",
      "source_jp": "注文は特にしなかったが、愛想がとてもよかったので許してしまった。",
      "draft_ko": "따로 주문은 하지 않았지만, 워낙 싹싹해서 그냥 넘어가 주었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2033",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2033,
      "speaker": "naomi",
      "source_jp": "「凛火先輩って、英語ペラペラだったんですね！」",
      "draft_ko": "“린카 선배, 영어가 유창하셨네요!”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2035",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2035,
      "speaker": "narrator",
      "source_jp": "お客さんが帰った後、直未は目を輝かせて言った。",
      "draft_ko": "손님이 돌아간 뒤 나오미는 눈을 빛내며 말했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2040",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2040,
      "speaker": "rinka",
      "source_jp": "「全然。喋れないけど？」",
      "draft_ko": "“전혀. 못하는데?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2045",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2045,
      "speaker": "naomi",
      "source_jp": "「謙遜……ですか？　だってさっきの女の人、英語だったじゃないですか？」",
      "draft_ko": "“겸손……이세요? 방금 그 여자분, 영어로 말했잖아요?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2052",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2052,
      "speaker": "rinka",
      "source_jp": "「え……？」",
      "draft_ko": "“어……?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2057",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2057,
      "speaker": "narrator",
      "source_jp": "直未に指摘された私の方が驚いてしまった。",
      "draft_ko": "나오미에게 지적받은 내가 오히려 놀라고 말았다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2059",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2059,
      "speaker": "narrator",
      "source_jp": "英語だった……？",
      "draft_ko": "영어였다고……?",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2061",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2061,
      "speaker": "narrator",
      "source_jp": "私としては、日本人と会話するのと何も変わらず話していたのだけれど。",
      "draft_ko": "내 입장에서는 일본인과 대화할 때와 조금도 다르지 않게 이야기했는데.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2063",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2063,
      "speaker": "narrator",
      "source_jp": "いや、でも。確かにあの人は日本語が分からず困っていたと言っていた。あんなに流暢に喋れるはずがない。",
      "draft_ko": "아니, 하지만. 분명 그 사람은 일본어를 몰라서 곤란했다고 말했다. 그렇게 유창하게 일본어를 할 수 있을 리 없다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2068",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2068,
      "speaker": "rinka",
      "source_jp": "「何でだろう？」",
      "draft_ko": "“왜 그런 거지?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2073",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2073,
      "speaker": "naomi",
      "source_jp": "「えっ、わたしに聞かれても……」",
      "draft_ko": "“네? 저한테 물으셔도……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2075",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2075,
      "speaker": "narrator",
      "source_jp": "とりあえず本を部屋の机の上に置いてから、私は代わりに英語の教科書を持ってきた。",
      "draft_ko": "일단 책을 방 책상 위에 올려놓은 뒤, 나는 대신 영어 교과서를 가져왔다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2080",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2080,
      "speaker": "rinka",
      "source_jp": "「適当に問題出してみて」",
      "draft_ko": "“아무거나 문제 내 봐.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2085",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2085,
      "speaker": "naomi",
      "source_jp": "「分かりました。単語でいいですね？　えっと……」",
      "draft_ko": "“알겠어요. 단어면 되죠? 어디 보자……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2090",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2090,
      "speaker": "narrator",
      "source_jp": "何問か問題を出されたが、結局ほとんど答えられなかった。",
      "draft_ko": "몇 문제를 받았지만 결국 거의 답하지 못했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2095",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2095,
      "speaker": "rinka",
      "source_jp": "「ね？　私英語できないでしょ？」",
      "draft_ko": "“봐. 나 영어 못하지?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2100",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2100,
      "speaker": "naomi",
      "source_jp": "「確かにそうですけど……ちょっとだけ先輩が心配になってきました……」",
      "draft_ko": "“확실히 그렇긴 한데요…… 선배가 조금 걱정되기 시작했어요……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2102",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2102,
      "speaker": "narrator",
      "source_jp": "オブラートに包んでいるようでストレートに私の英語のできなさを言っているのだろう。最後の方には直未は教科書を見ないで記憶で問題を出していた。",
      "draft_ko": "에둘러 말하는 듯하면서도 내 영어 실력이 형편없다고 정면으로 말하는 거겠지. 막판에는 나오미가 교과서를 보지도 않고 기억만으로 문제를 냈다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2104",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2104,
      "speaker": "narrator",
      "source_jp": "一応弁明しておくと、勉強が苦手な私だが、英語は特にできないのだ。",
      "draft_ko": "변명 삼아 덧붙이자면, 공부가 서툰 나지만 영어는 특히 못한다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2109",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2109,
      "speaker": "naomi",
      "source_jp": "「そうなると、さっき先輩が話せてたのが余計に不思議です……」",
      "draft_ko": "“그렇다면 아까 선배가 대화한 게 더더욱 이상하네요……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2111",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2111,
      "speaker": "narrator",
      "source_jp": "私としては何の違和感もなく会話をしていたので、直未に指摘される方が疑問だ。",
      "draft_ko": "나는 아무런 위화감 없이 대화했으니, 오히려 나오미가 지적하는 게 의문스럽다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2113",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2113,
      "speaker": "narrator",
      "source_jp": "とはいえ考えても答えは出ないので、もし次また外国のお客さんが来たら気にすることにしてみよう。",
      "draft_ko": "그래도 생각해 봐야 답은 나오지 않으니, 다음에 또 외국인 손님이 오면 의식해 보기로 하자.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2120",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2120,
      "speaker": "naomi",
      "source_jp": "「あ、あのそれで凛火先輩。せっかく来たので、今日もコーヒーをいただいてもいいですか？　もちろんお金は払うので！」",
      "draft_ko": "“아, 저, 그래서 린카 선배. 모처럼 왔으니 오늘도 커피를 마셔도 될까요? 물론 돈은 낼게요!”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2125",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2125,
      "speaker": "rinka",
      "source_jp": "「いいけど……いいの？」",
      "draft_ko": "“괜찮긴 한데…… 정말 괜찮겠어?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2130",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2130,
      "speaker": "naomi",
      "source_jp": "「はい！　先輩の淹れてくれたコーヒー、わたし、とっても好きです！」",
      "draft_ko": "“네! 선배가 내려 주신 커피, 저 정말 좋아해요!”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2132",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2132,
      "speaker": "narrator",
      "source_jp": "屈託のない笑顔で、直未はそう言った。",
      "draft_ko": "나오미는 해맑은 미소를 지으며 그렇게 말했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2136",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2136,
      "speaker": "narrator",
      "source_jp": "直未の言葉に、私は表現のできない嬉しさを感じていた。頬が熱くなるのを感じる。",
      "draft_ko": "나오미의 말에 나는 표현하기 힘든 기쁨을 느꼈다. 뺨이 달아오르는 게 느껴졌다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2138",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2138,
      "speaker": "narrator",
      "source_jp": "思えばお客さんも常連さんばかりでこんな風に言われたことはなかったかもしれない。",
      "draft_ko": "생각해 보니 손님도 단골뿐이라 이런 말을 들은 적은 없었을지도 모른다.",
      "source_authority": "Japanese only",
