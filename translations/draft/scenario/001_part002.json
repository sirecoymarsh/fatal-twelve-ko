  "entries": [
    {
      "stable_id": "scenario/001.rpy::f001_f743c599",
      "sequence": 51,
      "translation_id": "f001_f743c599",
      "source_file": "scenario/001.rpy",
      "source_line": 240,
      "speaker": "naomi",
      "source_jp": "「で、電車が来そうですし。い！行きましょう！」",
      "draft_ko": "“저, 전철도 곧 올 것 같고. 가, 가요!”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_4cc96fb3",
      "sequence": 52,
      "translation_id": "f001_4cc96fb3",
      "source_file": "scenario/001.rpy",
      "source_line": 242,
      "speaker": "narrator",
      "source_jp": "直未は転んだときにずれた眼鏡の位置を両手で直すと、慌てた調子でホームの方を指さした。",
      "draft_ko": "나오미는 넘어질 때 비뚤어진 안경을 양손으로 고쳐 쓰고는, 다급한 어조로 승강장 쪽을 가리켰다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_612a0fbe",
      "sequence": 53,
      "translation_id": "f001_612a0fbe",
      "source_file": "scenario/001.rpy",
      "source_line": 244,
      "speaker": "narrator",
      "source_jp": "１分前の繰り返しになるが、こういう時は大体――。",
      "draft_ko": "1분 전과 똑같은 말이 되겠지만, 이럴 때는 대개――.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_f67093cd",
      "sequence": 54,
      "translation_id": "f001_f67093cd",
      "source_file": "scenario/001.rpy",
      "source_line": 252,
      "speaker": "naomi",
      "source_jp": "「きゃっ！」",
      "draft_ko": "“꺅!”",
      "renpy_tail": " with quake_fast",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_3bc493f4",
      "sequence": 55,
      "translation_id": "f001_3bc493f4",
      "source_file": "scenario/001.rpy",
      "source_line": 257,
      "speaker": "rinka",
      "source_jp": "「もう、落ち着かないから！」",
      "draft_ko": "“정말, 좀 진정해!”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_4229b38e",
      "sequence": 56,
      "translation_id": "f001_4229b38e",
      "source_file": "scenario/001.rpy",
      "source_line": 261,
      "speaker": "narrator",
      "source_jp": "直未が歩き出したのと同時に通りかかった人にぶつかってしまう。",
      "draft_ko": "나오미가 걷기 시작한 순간 마침 지나가던 사람과 부딪치고 말았다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_f1d8c559",
      "sequence": 57,
      "translation_id": "f001_f1d8c559",
      "source_file": "scenario/001.rpy",
      "source_line": 263,
      "speaker": "narrator",
      "source_jp": "しかも、今度はぶつかった相手と一緒に転んでしまった。",
      "draft_ko": "게다가 이번에는 부딪친 상대와 함께 넘어지고 말았다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_588e8415",
      "sequence": 58,
      "translation_id": "f001_588e8415",
      "source_file": "scenario/001.rpy",
      "source_line": 268,
      "speaker": "naomi",
      "source_jp": "「す、すみません！」",
      "draft_ko": "“죄, 죄송해요!”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_a128379e",
      "sequence": 59,
      "translation_id": "f001_a128379e",
      "source_file": "scenario/001.rpy",
      "source_line": 273,
      "speaker": "rinka",
      "source_jp": "「ごめんなさい、私の後輩が……」",
      "draft_ko": "“미안해. 내 후배가……”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_164986d8",
      "sequence": 60,
      "translation_id": "f001_164986d8",
      "source_file": "scenario/001.rpy",
      "source_line": 279,
      "speaker": "narrator",
      "source_jp": "私は、起き上がろうとする直未たちの方へ近づいた。",
      "draft_ko": "나는 몸을 일으키려는 나오미와 상대 쪽으로 다가갔다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_53102087",
      "sequence": 61,
      "translation_id": "f001_53102087",
      "source_file": "scenario/001.rpy",
      "source_line": 281,
      "speaker": "narrator",
      "source_jp": "直未にぶつかられた相手は、直未よりも年下の少女に見えた。背丈は私とそう変わらないが、顔つきがもう少し幼かった。",
      "draft_ko": "나오미와 부딪친 상대는 나오미보다도 어린 소녀로 보였다. 키는 나와 별 차이가 없었지만, 얼굴 생김새가 조금 더 앳됐다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_b7cd9412",
      "sequence": 62,
      "translation_id": "f001_b7cd9412",
      "source_file": "scenario/001.rpy",
      "source_line": 283,
      "speaker": "narrator",
      "source_jp": "直未も大きな目のせいで高校生ではなく中学生に間違われがちだが、それよりも明らかに幼い。",
      "draft_ko": "나오미도 큰 눈 때문에 고등학생이 아니라 중학생으로 오해받곤 하지만, 그보다도 확실히 어려 보였다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_e5ceb827",
      "sequence": 63,
      "translation_id": "f001_e5ceb827",
      "source_file": "scenario/001.rpy",
      "source_line": 291,
      "speaker": "yuu_unk1",
      "source_jp": "「…………」",
      "draft_ko": "“…………”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_b8a8dcc6",
      "sequence": 64,
      "translation_id": "f001_b8a8dcc6",
      "source_file": "scenario/001.rpy",
      "source_line": 297,
      "speaker": "rinka",
      "source_jp": "「あ、あの。大丈夫かな？」",
      "draft_ko": "“저, 저기. 괜찮아?”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_5debcb07",
      "sequence": 65,
      "translation_id": "f001_5debcb07",
      "source_file": "scenario/001.rpy",
      "source_line": 306,
      "speaker": "narrator",
      "source_jp": "声をかけた時、少女と目が合った。目は薄い色をしていた。帽子で隠していたが、見れば、髪も特徴的で綺麗な白髪だ。",
      "draft_ko": "말을 건 순간 소녀와 눈이 마주쳤다. 눈동자는 옅은 색이었다. 모자에 가려져 있었지만, 자세히 보니 머리카락도 눈에 띄는 아름다운 백발이었다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_c2fa182f",
      "sequence": 66,
      "translation_id": "f001_c2fa182f",
      "source_file": "scenario/001.rpy",
      "source_line": 308,
      "speaker": "narrator",
      "source_jp": "正面からしっかり見ると、幼いながらもそのはっきりとした目鼻立ちが際立った。",
      "draft_ko": "정면에서 똑바로 보니, 어린 나이에도 또렷한 이목구비가 더욱 돋보였다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_076abf78",
      "sequence": 67,
      "translation_id": "f001_076abf78",
      "source_file": "scenario/001.rpy",
      "source_line": 310,
      "speaker": "narrator",
      "source_jp": "恐らく、日本人ではないのだろう。ということは髪の色も地毛かもしれない。",
      "draft_ko": "아마 일본인은 아닐 것이다. 그렇다면 머리색도 타고난 색일지 모른다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_e5ceb827_1",
      "sequence": 68,
      "translation_id": "f001_e5ceb827_1",
      "source_file": "scenario/001.rpy",
      "source_line": 317,
      "speaker": "yuu_unk1",
      "source_jp": "「…………」",
      "draft_ko": "“…………”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_e13fe35d",
      "sequence": 69,
      "translation_id": "f001_e13fe35d",
      "source_file": "scenario/001.rpy",
      "source_line": 319,
      "speaker": "narrator",
      "source_jp": "直未と異なり、少女は背中から転んでいた。",
      "draft_ko": "나오미와 달리 소녀는 등부터 바닥에 쓰러져 있었다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_7fb57779",
      "sequence": 70,
      "translation_id": "f001_7fb57779",
      "source_file": "scenario/001.rpy",
      "source_line": 321,
      "speaker": "narrator",
      "source_jp": "後ろからぶつかられたのだが、転んだ時に素早く身を反転させ、背負っていたリュックを抱えて守っていたようだ。",
      "draft_ko": "뒤에서 부딪혔는데도 넘어지는 순간 재빨리 몸을 돌려, 등에 메고 있던 배낭을 끌어안아 지킨 모양이다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_ca0a2d04",
      "sequence": 71,
      "translation_id": "f001_ca0a2d04",
      "source_file": "scenario/001.rpy",
      "source_line": 323,
      "speaker": "narrator",
      "source_jp": "ずいぶん大きな荷物だ。恐らく、旅行者だろう。",
      "draft_ko": "제법 큰 짐이었다. 아마 여행객이겠지.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_1c06b871",
      "sequence": 72,
      "translation_id": "f001_1c06b871",
      "source_file": "scenario/001.rpy",
      "source_line": 325,
      "speaker": "narrator",
      "source_jp": "鞄の中にカメラなどの壊れやすいものが入っているために、荷物をかばったのかもしれない。",
      "draft_ko": "가방 안에 카메라 같은 깨지기 쉬운 물건이 들어 있어서 짐을 감싼 걸지도 모른다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_5c55d1dd",
      "sequence": 73,
      "translation_id": "f001_5c55d1dd",
      "source_file": "scenario/001.rpy",
      "source_line": 327,
      "speaker": "narrator",
      "source_jp": "一人でいるということは、家族で日本に来ていてはぐれてしまったのだろうか。",
      "draft_ko": "혼자 있는 걸 보면 가족과 함께 일본에 왔다가 떨어진 걸까.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_5537a09b",
      "sequence": 74,
      "translation_id": "f001_5537a09b",
      "source_file": "scenario/001.rpy",
      "source_line": 329,
      "speaker": "narrator",
      "source_jp": "リュックには鍵の形をしたキーホルダーがついていた。",
      "draft_ko": "배낭에는 열쇠 모양의 열쇠고리가 달려 있었다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_20305a99",
      "sequence": 75,
      "translation_id": "f001_20305a99",
      "source_file": "scenario/001.rpy",
      "source_line": 331,
      "speaker": "narrator",
      "source_jp": "少女はすぐにすっくと立ち上がって、自分のかばった荷物を抱えたままこちらを睨むように見つめていた。",
      "draft_ko": "소녀는 곧바로 벌떡 일어나 자신이 감싸 지킨 짐을 끌어안은 채, 우리를 노려보듯 바라보고 있었다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_833e8ce2",
      "sequence": 76,
      "translation_id": "f001_833e8ce2",
      "source_file": "scenario/001.rpy",
      "source_line": 337,
      "speaker": "yuu_unk2",
      "source_jp": "「…………」",
      "draft_ko": "“…………”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_edf4bd95",
      "sequence": 77,
      "translation_id": "f001_edf4bd95",
      "source_file": "scenario/001.rpy",
      "source_line": 346,
      "speaker": "rinka",
      "source_jp": "「直未、ほら、ちゃんと謝らないと」",
      "draft_ko": "“나오미, 자. 제대로 사과해야지.”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_31ef98a3",
      "sequence": 78,
      "translation_id": "f001_31ef98a3",
      "source_file": "scenario/001.rpy",
      "source_line": 348,
      "speaker": "narrator",
      "source_jp": "直未は慌てていたのもあり立ち上がるのに手間取っていたようで、結局私の手を借りて体勢を整えた。",
      "draft_ko": "나오미는 당황한 탓인지 일어서는 데 애를 먹고 있었고, 결국 내 손을 빌려 자세를 추슬렀다.",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_26bc2806",
      "sequence": 79,
      "translation_id": "f001_26bc2806",
      "source_file": "scenario/001.rpy",
      "source_line": 353,
      "speaker": "naomi",
      "source_jp": "「ほっ、本当にごめんなさい……あれ、外国の人？　わたしの言葉通じてっ……、こういう時はその、ソーリー？　パードン？」",
      "draft_ko": "“저, 정말 죄송해요…… 어라, 외국인인가? 제 말이 통하……, 이럴 때는 그, 쏘리? 파든?”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_6c394e5f",
      "sequence": 80,
      "translation_id": "f001_6c394e5f",
      "source_file": "scenario/001.rpy",
      "source_line": 358,
      "speaker": "rinka",
      "source_jp": "「直未、とりあえず落ち着きなって」",
      "draft_ko": "“나오미, 일단 진정해.”",
      "renpy_tail": "",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
