  "entries": [
    {
      "stable_id": "scenario/TRUE_END.rpy::L32",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 32,
      "speaker": "mao",
      "source_jp": "「やああああああっとこの日が来たねぇ！」",
      "draft_ko": "「드으으디어 이날이 왔네!」",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L34",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 34,
      "speaker": "narrator",
      "source_jp": "ライオン館にまずやって来たのは、真央だった。",
      "draft_ko": "라이온관에 가장 먼저 찾아온 건 마오였다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L36",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 36,
      "speaker": "narrator",
      "source_jp": "夏休み真っ只中のこの日。",
      "draft_ko": "여름방학이 한창인 이날.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L38",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 38,
      "speaker": "narrator",
      "source_jp": "私たちは花火大会へ行く約束をしていた。",
      "draft_ko": "우리는 불꽃놀이 축제에 가기로 약속했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L43",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 43,
      "speaker": "mao",
      "source_jp": "「なおりんは塾で忙しいし、みはるんはバイトで忙しいし、りーたんはお店で忙しいしぃで、全然時間とれなかったもんねぇ」",
      "draft_ko": "「나오링은 학원 때문에 바쁘고, 미하룽은 알바로 바쁘고, 리땅은 가게로 바빠서 전혀 시간이 안 났잖아」",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L48",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 48,
      "speaker": "mao",
      "source_jp": "「みんなで集まるの、りーたんの誕生日以来じゃない？」",
      "draft_ko": "「모두 함께 모이는 거, 리땅 생일 이후 처음 아니야?」",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L53",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 53,
      "speaker": "rinka",
      "source_jp": "「そういえば……そうかも」",
      "draft_ko": "「그러고 보니…… 그럴지도」",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L55",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 55,
      "speaker": "narrator",
      "source_jp": "最後に集まったのは、７月２７日。",
      "draft_ko": "마지막으로 모인 날은 7월 27일.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L57",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 57,
      "speaker": "narrator",
      "source_jp": "私自身すっかり自分の誕生日を忘れていて、普通にお店を開けていた。",
      "draft_ko": "나 자신도 생일을 완전히 잊고 평소처럼 가게를 열었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L59",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 59,
      "speaker": "narrator",
      "source_jp": "お店の終わり際に海晴、真央、直未がサプライズで来てくれた。",
      "draft_ko": "가게 문을 닫을 무렵 미하루와 마오, 나오미가 깜짝 방문을 해 주었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L61",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 61,
      "speaker": "narrator",
      "source_jp": "どうせ忘れている、という真央の予想が大当たりした形になった。",
      "draft_ko": "어차피 잊고 있을 거라는 마오의 예상이 완전히 적중한 셈이었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L63",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 63,
      "speaker": "narrator",
      "source_jp": "料理は海晴がここで作ってくれて、ケーキは直未がおうちで焼いてきてくれた。",
      "draft_ko": "요리는 미하루가 여기서 만들어 주었고, 케이크는 나오미가 집에서 구워 왔다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L65",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 65,
      "speaker": "narrator",
      "source_jp": "海晴は私の好物が分からなくて困ったということで、主にイタリアンで、とにかく色々なものを作ってくれた。",
      "draft_ko": "미하루는 내가 뭘 좋아하는지 몰라 곤란했다며, 주로 이탈리아 요리로 이것저것 잔뜩 만들어 주었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L67",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 67,
      "speaker": "narrator",
      "source_jp": "そういえば、私はあまり好きな食べ物の話をしたことがなかった。",
      "draft_ko": "그러고 보니 나는 좋아하는 음식에 관해 별로 말한 적이 없었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L69",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 69,
      "speaker": "narrator",
      "source_jp": "その時に食べたプッタネスカというパスタは、とても美味しかった。赤かったし。",
      "draft_ko": "그때 먹은 푸타네스카라는 파스타는 무척 맛있었다. 빨갛기도 했고.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L71",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 71,
      "speaker": "narrator",
      "source_jp": "直未は私が極端に甘いものが苦手なのを覚えていてくれて、甘さ控えめのシフォンケーキに、ほどよい甘さの生クリームがコーティングしてある力作だった。",
      "draft_ko": "나오미는 내가 아주 단 음식을 싫어한다는 걸 기억해 주어서, 덜 달게 만든 시폰케이크에 적당히 달콤한 생크림을 입힌 역작을 준비했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L73",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 73,
      "speaker": "narrator",
      "source_jp": "紅茶風味だったのは、もしかしたらダイアナが入っていた名残かもしれないというのは、考え過ぎだろうか。",
      "draft_ko": "홍차 맛이었던 건 어쩌면 다이아나가 들어 있었던 흔적일지도 모른다는 생각은 너무 나간 걸까.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L75",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 75,
      "speaker": "narrator",
      "source_jp": "しかも、３人からそれぞれプレゼントまでもらってしまった。",
      "draft_ko": "게다가 세 사람에게 각자 선물까지 받고 말았다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L77",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 77,
      "speaker": "narrator",
      "source_jp": "海晴からは、花束をもらった。私の好きな赤を中心とした花束だ。花瓶に入れてお店に飾ると、ライオン館をより私のお店にしてくれた。",
      "draft_ko": "미하루에게서는 꽃다발을 받았다. 내가 좋아하는 빨간색을 중심으로 꾸민 꽃다발이다. 꽃병에 꽂아 가게에 장식하니 라이온관이 한층 더 나다운 가게가 되었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L79",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 79,
      "speaker": "narrator",
      "source_jp": "直未のプレゼントは、本だ。ハードカバーの海外小説。直未が好きな作品で、読み易いながら哲学的な要素もあるらしい。版画の挿絵も、シックな雰囲気で可愛らしい。",
      "draft_ko": "나오미의 선물은 책이었다. 양장본 해외 소설. 나오미가 좋아하는 작품으로, 읽기 쉬우면서도 철학적인 요소가 있다고 한다. 판화 삽화도 세련된 분위기라 귀여웠다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L81",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 81,
      "speaker": "narrator",
      "source_jp": "真央からはハンドクリームなどの詰め合わせセット。洗い物が多い私は手が荒れがちなので、実用的でありがたい。それにお店に影響が出ないよう、わざわざ無香料のものを選んでくれた。",
      "draft_ko": "마오에게서는 핸드크림 등이 든 선물 세트를 받았다. 설거지를 많이 해서 손이 자주 트는 내게 실용적이고 고마운 선물이었다. 게다가 가게에 영향이 없도록 일부러 무향 제품을 골라 주었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L83",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 83,
      "speaker": "narrator",
      "source_jp": "どれも私のことを想ってくれたもので、とても嬉しかった。",
      "draft_ko": "어느 것이나 나를 생각해 고른 것이어서 무척 기뻤다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L85",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 85,
      "speaker": "narrator",
      "source_jp": "しかもその夜はおばあちゃんからも電話が来て、とても充実した一日になった。",
      "draft_ko": "게다가 그날 밤에는 할머니에게서도 전화가 와서 무척 알찬 하루가 되었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L90",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 90,
      "speaker": "mao",
      "source_jp": "「あ、なおりんはおうちにある浴衣を借りるから、直接待ち合わせだって」",
      "draft_ko": "「아, 나오링은 집에 있는 유카타를 빌려 입을 거라 현장에서 바로 만나재」",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L95",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 95,
      "speaker": "mao",
      "source_jp": "「ってことはあとは」",
      "draft_ko": "「그럼 이제 남은 건」",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L100",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 100,
      "speaker": "miharu",
      "source_jp": "「お待たせ、凛火、真央」",
      "draft_ko": "「기다렸지, 린카, 마오」",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L102",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 102,
      "speaker": "narrator",
      "source_jp": "真央が到着してから10分程経って、海晴がライオン館に来た。",
      "draft_ko": "마오가 도착하고 10분쯤 지나 미하루가 라이온관에 왔다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L107",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 107,
      "speaker": "miharu",
      "source_jp": "「直未はまだ来ないのかい？」",
      "draft_ko": "「나오미는 아직 안 오는 거야?」",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/TRUE_END.rpy::L112",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/TRUE_END.rpy",
      "source_line": 112,
      "speaker": "mao",
      "source_jp": "「なおりんは、現地しゅーごーだって」",
      "draft_ko": "「나오링은 현지 집합이래」",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
