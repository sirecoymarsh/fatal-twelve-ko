      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/BAD_END_02.rpy",
      "source_line": 84,
      "speaker": "narrator",
      "source_jp": "文化祭で直未のクラスの模擬店で、凛火仕込みのコーヒーを飲んだこと。",
      "draft_ko": "문화제 때 나오미네 반 모의점에서 린카에게 배운 방식으로 내린 커피를 마셨던 일.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
