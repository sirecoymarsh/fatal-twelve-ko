{
  "packet_id": "scenario_001_part001",
  "source_language": "Japanese",
  "target_language": "Korean",
  "entry_count": 50,
  "status": "first_draft_unreviewed",
  "qa_policy": "No translation QA until the complete first draft is finished; review once afterward.",
  "english_text_in_translator_packet": false,
  "entries": [
    {
      "stable_id": "scenario/001.rpy::f001_9ce2c448",
      "sequence": 1,
      "translation_id": "f001_9ce2c448",
      "source_file": "scenario/001.rpy",
      "source_line": 32,
      "speaker": "narrator",
      "source_jp": "一つの結果に到達するまでの過程を、人は物語や人生と呼ぶ。",
      "draft_ko": "하나의 결과에 도달하기까지의 과정을 사람들은 이야기나 인생이라 부른다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_365e9d7b",
      "sequence": 2,
      "translation_id": "f001_365e9d7b",
      "source_file": "scenario/001.rpy",
      "source_line": 34,
      "speaker": "narrator",
      "source_jp": "様々な出会いがあり、別れがあり、事件があり、選択があり、そして未来の可能性の中を進み、一つの結果へ到達する。",
      "draft_ko": "그 과정에는 수많은 만남과 이별, 사건과 선택이 있으며, 그렇게 미래의 가능성 속을 나아가 하나의 결과에 도달한다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_1dcd767b",
      "sequence": 3,
      "translation_id": "f001_1dcd767b",
      "source_file": "scenario/001.rpy",
      "source_line": 36,
      "speaker": "narrator",
      "source_jp": "この世界というのは――運命というのは、そういう風にできている。",
      "draft_ko": "이 세계는――운명은, 그렇게 이루어져 있다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_d2cb40bf",
      "sequence": 4,
      "translation_id": "f001_d2cb40bf",
      "source_file": "scenario/001.rpy",
      "source_line": 38,
      "speaker": "narrator",
      "source_jp": "運命は変わらないから運命なんだ。どんなに理不尽でも。",
      "draft_ko": "운명은 변하지 않기에 운명이다. 아무리 불합리하더라도.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_1cc3f16e",
      "sequence": 5,
      "translation_id": "f001_1cc3f16e",
      "source_file": "scenario/001.rpy",
      "source_line": 40,
      "speaker": "narrator",
      "source_jp": "これまで生きてきた私の人生の中で起きたこと、その全ては何かの過程の結果なのだ。",
      "draft_ko": "지금껏 살아온 내 인생에서 일어난 일들, 그 모든 것은 어떤 과정 끝에 나온 결과다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_98ad5030",
      "sequence": 6,
      "translation_id": "f001_98ad5030",
      "source_file": "scenario/001.rpy",
      "source_line": 42,
      "speaker": "narrator",
      "source_jp": "その途中で失われた可能性のことなんて、私は考えたことがなかった。",
      "draft_ko": "그 도중에 사라진 가능성 따위, 나는 생각해 본 적이 없었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_8869472c",
      "sequence": 7,
      "translation_id": "f001_8869472c",
      "source_file": "scenario/001.rpy",
      "source_line": 44,
      "speaker": "narrator",
      "source_jp": "たら、れば、かもしれないに思いを馳せるほど、壮絶な人生ではなかったのだ。",
      "draft_ko": "했더라면, 그랬다면, 어쩌면 같은 말에 생각이 잠길 만큼 파란만장한 인생은 아니었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_f21956c5",
      "sequence": 8,
      "translation_id": "f001_f21956c5",
      "source_file": "scenario/001.rpy",
      "source_line": 46,
      "speaker": "narrator",
      "source_jp": "物語は、人生は、たった一つだと思い込んでいた。",
      "draft_ko": "이야기도, 인생도, 단 하나뿐이라고 굳게 믿고 있었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_8024772c",
      "sequence": 9,
      "translation_id": "f001_8024772c",
      "source_file": "scenario/001.rpy",
      "source_line": 58,
      "speaker": "narrator",
      "source_jp": "私の名前は、{rb}獅子舞{/rb}{rt}ししまい{/rt}{rb}凛火{/rb}{rt}りんか{/rt}。",
      "draft_ko": "내 이름은 시시마이 린카.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_bc643489",
      "sequence": 10,
      "translation_id": "f001_bc643489",
      "source_file": "scenario/001.rpy",
      "source_line": 60,
      "speaker": "narrator",
      "source_jp": "都内でそこそこ有名な女子校、私立{rb}飴茶{/rb}{rt}あめちゃ{/rt}女子大学付属高校の２年生だ。",
      "draft_ko": "도쿄에서 제법 유명한 여학교, 사립 아메차 여자대학 부속 고등학교 2학년이다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_823596c6",
      "sequence": 11,
      "translation_id": "f001_823596c6",
      "source_file": "scenario/001.rpy",
      "source_line": 62,
      "speaker": "narrator",
      "source_jp": "トップ高に入った優等生からほとんど学校に来ない問題児まで色々な人がいた中学時代とは打って変わり、ここでは大人しいお嬢様ばかりだ。",
      "draft_ko": "최상위권 고등학교에 진학한 우등생부터 학교에 거의 나오지 않는 문제아까지 별별 애들이 다 있던 중학교 때와는 달리, 이곳에는 얌전한 아가씨들뿐이다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_f123f239",
      "sequence": 12,
      "translation_id": "f001_f123f239",
      "source_file": "scenario/001.rpy",
      "source_line": 64,
      "speaker": "narrator",
      "source_jp": "そんな中、私は周囲から不良のレッテルを貼られていた。",
      "draft_ko": "그런 가운데 나는 주변으로부터 불량학생이라는 딱지가 붙어 있었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_7f693824",
      "sequence": 13,
      "translation_id": "f001_7f693824",
      "source_file": "scenario/001.rpy",
      "source_line": 66,
      "speaker": "narrator",
      "source_jp": "理由のひとつが――そしてそれがもっとも大きいのだけど――黒に金色のメッシュが入った髪にあった。",
      "draft_ko": "이유 중 하나가――그리고 그게 가장 큰 이유였는데――검은색 사이사이에 금빛이 섞인 내 머리카락이었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_d9a60451",
      "sequence": 14,
      "translation_id": "f001_d9a60451",
      "source_file": "scenario/001.rpy",
      "source_line": 68,
      "speaker": "narrator",
      "source_jp": "地毛なのだから校則や偏見でとやかく言われることもないのだけれど、どうやら小学校からずっと女子校のお嬢様たちにはアバンギャルドに過ぎるらしい。",
      "draft_ko": "타고난 머리색이라 교칙이나 편견을 들먹이며 이래라저래라 할 일은 없었지만, 초등학교 때부터 줄곧 여학교만 다닌 아가씨들에게는 아무래도 너무 파격적인 모양이다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_481b5537",
      "sequence": 15,
      "translation_id": "f001_481b5537",
      "source_file": "scenario/001.rpy",
      "source_line": 70,
      "speaker": "narrator",
      "source_jp": "服装や容姿に関する校則が緩いからこそ私は飴茶を選んだのに、実態は暗黙のルールだか伝統だかが染みついているから校則の規定がないというだけであった。",
      "draft_ko": "복장이나 외모에 관한 교칙이 느슨해서 아메차를 골랐건만, 실상은 암묵적인 규칙인지 전통인지가 워낙 뿌리 깊어서 굳이 교칙에 적어 놓지 않았을 뿐이었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_b4fa6dee",
      "sequence": 16,
      "translation_id": "f001_b4fa6dee",
      "source_file": "scenario/001.rpy",
      "source_line": 72,
      "speaker": "narrator",
      "source_jp": "入学したての頃こそ校則違反ではないのに見た目だけで不良扱いされることに腹を立てたが、３ヵ月も経たずに気にならなくなった。",
      "draft_ko": "입학 초기에는 교칙을 어긴 것도 아닌데 겉모습만 보고 불량학생 취급하는 게 화났지만, 석 달도 지나지 않아 신경 쓰이지 않게 됐다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_4c787f24",
      "sequence": 17,
      "translation_id": "f001_4c787f24",
      "source_file": "scenario/001.rpy",
      "source_line": 74,
      "speaker": "narrator",
      "source_jp": "私には私の世界があるように、彼女たちには彼女たちの世界があることが分かったからだ。",
      "draft_ko": "나에게 나만의 세계가 있듯, 그녀들에게도 그녀들만의 세계가 있다는 걸 알았기 때문이다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_62952f0d",
      "sequence": 18,
      "translation_id": "f001_62952f0d",
      "source_file": "scenario/001.rpy",
      "source_line": 76,
      "speaker": "narrator",
      "source_jp": "私が彼女たちの価値観を理解できないように、彼女たちもまた私の価値観を理解することはない。",
      "draft_ko": "내가 그녀들의 가치관을 이해할 수 없듯, 그녀들 역시 내 가치관을 이해하지 못한다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_f5ed11df",
      "sequence": 19,
      "translation_id": "f001_f5ed11df",
      "source_file": "scenario/001.rpy",
      "source_line": 78,
      "speaker": "narrator",
      "source_jp": "実のところ、これまでの私はそんな風に理解できるものだけを理解して生きていくのだと割り切っていた。",
      "draft_ko": "사실 지금까지의 나는 그렇게, 이해할 수 있는 것만 이해하며 살아가면 된다고 선을 그어 왔다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_5f791863",
      "sequence": 20,
      "translation_id": "f001_5f791863",
      "source_file": "scenario/001.rpy",
      "source_line": 80,
      "speaker": "narrator",
      "source_jp": "だが、ある時を境に運命の歯車が大きく動き出すことになった。",
      "draft_ko": "하지만 어느 순간을 기점으로 운명의 톱니바퀴가 크게 움직이기 시작했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_eb489c3e",
      "sequence": 21,
      "translation_id": "f001_eb489c3e",
      "source_file": "scenario/001.rpy",
      "source_line": 82,
      "speaker": "narrator",
      "source_jp": "それは、ゴールデンウィーク直前のある日からだった――。",
      "draft_ko": "그건 골든위크 직전, 어느 날부터였다――.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_9e0ab144",
      "sequence": 22,
      "translation_id": "f001_9e0ab144",
      "source_file": "scenario/001.rpy",
      "source_line": 112,
      "speaker": "rinka",
      "source_jp": "「見て。駅の時計止まっちゃってる……故障かな？」",
      "draft_ko": "“봐. 역 시계가 멈췄어…… 고장 났나?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_619b8ef6",
      "sequence": 23,
      "translation_id": "f001_619b8ef6",
      "source_file": "scenario/001.rpy",
      "source_line": 114,
      "speaker": "narrator",
      "source_jp": "改札口を抜けた先にあるアナログ時計に目を遣って、私は{rb}直未{/rb}{rt}なおみ{/rt}に話しかけた。",
      "draft_ko": "개찰구를 빠져나온 곳에 있는 아날로그 시계로 눈을 돌리며, 나는 나오미에게 말을 걸었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_17909fec",
      "sequence": 24,
      "translation_id": "f001_17909fec",
      "source_file": "scenario/001.rpy",
      "source_line": 120,
      "speaker": "naomi",
      "source_jp": "「本当だ……凛火先輩、よく気付きましたね！　駅の時計が止まってるなんて珍しいのに」",
      "draft_ko": "“정말이네요…… 린카 선배, 용케 알아채셨네요! 역 시계가 멈춰 있다니 드문 일인데요.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_c934fe7d",
      "sequence": 25,
      "translation_id": "f001_c934fe7d",
      "source_file": "scenario/001.rpy",
      "source_line": 125,
      "speaker": "rinka",
      "source_jp": "「だよね。あ、ごめん、直未の話、遮っちゃったよね？　何の話だっけ？」",
      "draft_ko": "“그치? 아, 미안. 나오미 말 끊었지? 무슨 얘기였더라?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_80a288e9",
      "sequence": 26,
      "translation_id": "f001_80a288e9",
      "source_file": "scenario/001.rpy",
      "source_line": 130,
      "speaker": "naomi",
      "source_jp": "「えっと、あれですよ、あれ。あの……はははー、わたしも忘れちゃいました」",
      "draft_ko": "“그러니까, 그거예요, 그거. 저기…… 하하하, 저도 잊어버렸어요.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_94682d80",
      "sequence": 27,
      "translation_id": "f001_94682d80",
      "source_file": "scenario/001.rpy",
      "source_line": 147,
      "speaker": "narrator",
      "source_jp": "はにかみながら答えたのは、一つ年下の{rb}日辻{/rb}{rt}ひつじ{/rt}{rb}直未{/rb}{rt}なおみ{/rt}だ。",
      "draft_ko": "수줍게 웃으며 대답한 사람은 한 살 아래인 히츠지 나오미다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_53b2ce10",
      "sequence": 28,
      "translation_id": "f001_53b2ce10",
      "source_file": "scenario/001.rpy",
      "source_line": 149,
      "speaker": "narrator",
      "source_jp": "後輩といっても部活や委員会で知り合ったわけではなく、ちょっとした偶然で私たちは先輩後輩の関係になった。",
      "draft_ko": "후배라고는 해도 동아리나 위원회에서 만난 건 아니고, 사소한 우연을 계기로 우리는 선후배 사이가 됐다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_8de07126",
      "sequence": 29,
      "translation_id": "f001_8de07126",
      "source_file": "scenario/001.rpy",
      "source_line": 151,
      "speaker": "narrator",
      "source_jp": "私は上下関係とか気にしないから、友達って感じだけど。",
      "draft_ko": "나는 위아래 관계 같은 건 신경 쓰지 않으니, 친구에 가깝지만.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_28abb60e",
      "sequence": 30,
      "translation_id": "f001_28abb60e",
      "source_file": "scenario/001.rpy",
      "source_line": 153,
      "speaker": "narrator",
      "source_jp": "直未と私は、二人でうちへ向かう途中であった。いつものように駅の改札を抜け、ホームへと向かっている。",
      "draft_ko": "나오미와 나는 둘이서 우리 집으로 가는 길이었다. 여느 때처럼 역 개찰구를 지나 승강장으로 향하고 있었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_8e0e7d7f",
      "sequence": 31,
      "translation_id": "f001_8e0e7d7f",
      "source_file": "scenario/001.rpy",
      "source_line": 163,
      "speaker": "naomi",
      "source_jp": "「わきゃっ！」",
      "draft_ko": "“꺅!”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_75c7f5d5",
      "sequence": 32,
      "translation_id": "f001_75c7f5d5",
      "source_file": "scenario/001.rpy",
      "source_line": 169,
      "speaker": "rinka",
      "source_jp": "「ちょっと」",
      "draft_ko": "“조심해.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_49521422",
      "sequence": 33,
      "translation_id": "f001_49521422",
      "source_file": "scenario/001.rpy",
      "source_line": 171,
      "speaker": "narrator",
      "source_jp": "小さな悲鳴をあげた直後、直未は何もないところで転びそうになり、体が傾いた。",
      "draft_ko": "작게 비명을 지른 직후, 나오미는 아무것도 없는 곳에서 넘어질 듯 몸이 기울었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_5f66ce55",
      "sequence": 34,
      "translation_id": "f001_5f66ce55",
      "source_file": "scenario/001.rpy",
      "source_line": 173,
      "speaker": "narrator",
      "source_jp": "私は直未の手を掴んで、体を支える。",
      "draft_ko": "나는 나오미의 손을 붙잡아 몸을 받쳐 주었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_d5615035",
      "sequence": 35,
      "translation_id": "f001_d5615035",
      "source_file": "scenario/001.rpy",
      "source_line": 175,
      "speaker": "narrator",
      "source_jp": "私の方が体が小さいのでちょっと引っ張られたが、直未もすぐ自分で体勢を整えていた。",
      "draft_ko": "내 쪽이 체구가 작아 살짝 끌려가긴 했지만, 나오미도 금세 스스로 자세를 바로잡았다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_99d0f9a5",
      "sequence": 36,
      "translation_id": "f001_99d0f9a5",
      "source_file": "scenario/001.rpy",
      "source_line": 180,
      "speaker": "naomi",
      "source_jp": "「す、すみません……」",
      "draft_ko": "“죄, 죄송해요……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_38e83cc7",
      "sequence": 37,
      "translation_id": "f001_38e83cc7",
      "source_file": "scenario/001.rpy",
      "source_line": 186,
      "speaker": "rinka",
      "source_jp": "「別に、謝ることじゃないよ」",
      "draft_ko": "“딱히 사과할 일은 아니야.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_47ae53a1",
      "sequence": 38,
      "translation_id": "f001_47ae53a1",
      "source_file": "scenario/001.rpy",
      "source_line": 190,
      "speaker": "naomi",
      "source_jp": "「あ、ありがとうございます！」",
      "draft_ko": "“가, 감사합니다!”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_7992c73e",
      "sequence": 39,
      "translation_id": "f001_7992c73e",
      "source_file": "scenario/001.rpy",
      "source_line": 195,
      "speaker": "rinka",
      "source_jp": "「それもなんか大げさ」",
      "draft_ko": "“그것도 좀 거창한데.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_d4f16a28",
      "sequence": 40,
      "translation_id": "f001_d4f16a28",
      "source_file": "scenario/001.rpy",
      "source_line": 197,
      "speaker": "narrator",
      "source_jp": "直未はいつもどこかおどおどしていて、そのせいで注意力散漫なのか分からないが――よく転ぶ。",
      "draft_ko": "나오미는 늘 어딘가 안절부절못한다. 그래서 주의가 산만한 건지는 모르겠지만――자주 넘어진다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_8df83878",
      "sequence": 41,
      "translation_id": "f001_8df83878",
      "source_file": "scenario/001.rpy",
      "source_line": 199,
      "speaker": "narrator",
      "source_jp": "小動物みたいで、どちらかというと守ってあげたくなるタイプだと思う。",
      "draft_ko": "작은 동물 같아서, 굳이 따지면 지켜 주고 싶어지는 타입이라고 생각한다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_aeb21865",
      "sequence": 42,
      "translation_id": "f001_aeb21865",
      "source_file": "scenario/001.rpy",
      "source_line": 204,
      "speaker": "naomi",
      "source_jp": "「それで、その……」",
      "draft_ko": "“그래서, 저기……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_3dde34fb",
      "sequence": 43,
      "translation_id": "f001_3dde34fb",
      "source_file": "scenario/001.rpy",
      "source_line": 209,
      "speaker": "rinka",
      "source_jp": "「ん？　どうしたの？」",
      "draft_ko": "“응? 왜 그래?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_e2203c0a",
      "sequence": 44,
      "translation_id": "f001_e2203c0a",
      "source_file": "scenario/001.rpy",
      "source_line": 214,
      "speaker": "naomi",
      "source_jp": "「えっと……手……」",
      "draft_ko": "“저기…… 손이요……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_1db0b123",
      "sequence": 45,
      "translation_id": "f001_1db0b123",
      "source_file": "scenario/001.rpy",
      "source_line": 216,
      "speaker": "narrator",
      "source_jp": "直未を支えたときからずっと、手を握ったままでいたみたいだ。",
      "draft_ko": "나오미를 받쳐 준 뒤로 줄곧 손을 잡은 채였던 모양이다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_1be9ae60",
      "sequence": 46,
      "translation_id": "f001_1be9ae60",
      "source_file": "scenario/001.rpy",
      "source_line": 221,
      "speaker": "rinka",
      "source_jp": "「あ、ごめん。痛かった？」",
      "draft_ko": "“아, 미안. 아팠어?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_c3e05e7c",
      "sequence": 47,
      "translation_id": "f001_c3e05e7c",
      "source_file": "scenario/001.rpy",
      "source_line": 226,
      "speaker": "naomi",
      "source_jp": "「い、いえ！　全然……痛くはない、ですけど……」",
      "draft_ko": "“아, 아니요! 전혀…… 아프지는, 않은데요……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_4595dbfc",
      "sequence": 48,
      "translation_id": "f001_4595dbfc",
      "source_file": "scenario/001.rpy",
      "source_line": 228,
      "speaker": "narrator",
      "source_jp": "直未はうつむいたまま、そう答えた。",
      "draft_ko": "나오미는 고개를 숙인 채 그렇게 대답했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_4df66257",
      "sequence": 49,
      "translation_id": "f001_4df66257",
      "source_file": "scenario/001.rpy",
      "source_line": 230,
      "speaker": "narrator",
      "source_jp": "自覚はなかったがちょっと強く握り過ぎたかもしれないと思い、私は恐る恐る手を離した。",
      "draft_ko": "자각은 없었지만 조금 세게 잡았을지도 모르겠다는 생각에, 나는 조심조심 손을 놓았다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::f001_ba90f33d",
      "sequence": 50,
      "translation_id": "f001_ba90f33d",
      "source_file": "scenario/001.rpy",
      "source_line": 235,
      "speaker": "naomi",
      "source_jp": "「あ！　そ、その！」",
      "draft_ko": "“아! 저, 저기!”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    }
  ]
}