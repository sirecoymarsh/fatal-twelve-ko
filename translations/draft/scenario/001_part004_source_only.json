  "entries": [
    {
      "stable_id": "scenario/001.rpy::L1611",
      "sequence": 351,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1611,
      "speaker": "rinka",
      "source_jp": "「はぁっ、はぁっ」",
      "draft_ko": "“하아, 하아.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1613",
      "sequence": 352,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1613,
      "speaker": "narrator",
      "source_jp": "まだ息苦しく、汗もかいていた。",
      "draft_ko": "여전히 숨쉬기 답답했고, 땀도 나 있었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1615",
      "sequence": 353,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1615,
      "speaker": "narrator",
      "source_jp": "一体どうしてそんな夢を――と疑問に思ったところで、私は自分のお腹に黒い物体が乗っかっているのを見つけた。",
      "draft_ko": "대체 왜 그런 꿈을――하고 의문을 품은 순간, 내 배 위에 검은 물체가 올라앉아 있는 것을 발견했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1620",
      "sequence": 354,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1620,
      "speaker": "rinka",
      "source_jp": "「あんたか……」",
      "draft_ko": "“너였냐……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1626",
      "sequence": 355,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1626,
      "speaker": "lete",
      "source_jp": "「にゃーお」",
      "draft_ko": "“냐아옹.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1628",
      "sequence": 356,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1628,
      "speaker": "narrator",
      "source_jp": "猫のレテだ。おばあちゃんが買ってきたのか、もともと野良猫だったのが住み着いたのか分からないが、喫茶ライオン館に住み着いている黒猫だ。",
      "draft_ko": "고양이 레테다. 할머니가 사 온 건지, 원래 길고양이였다가 눌러앉은 건지는 모르지만, 찻집 라이온관에 사는 검은 고양이다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1630",
      "sequence": 357,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1630,
      "speaker": "narrator",
      "source_jp": "私が物心ついた時から一緒で、もうかなりの高齢のはずにもかかわらず元気だ。",
      "draft_ko": "내가 철들기 전부터 함께했고, 이제 상당히 나이가 많을 텐데도 건강하다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1632",
      "sequence": 358,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1632,
      "speaker": "narrator",
      "source_jp": "この猫が布団越しに私のお腹の上に乗っていたせいで、息苦しかったようだ。悪い夢を見たのはそのせいだろう。",
      "draft_ko": "이 고양이가 이불 너머로 내 배 위에 올라앉아 있어서 숨이 답답했던 모양이다. 나쁜 꿈을 꾼 것도 그 때문이겠지.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1636",
      "sequence": 359,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1636,
      "speaker": "narrator",
      "source_jp": "私が起きたのに気が付くと、レテはぴょんとベッドから飛び降り、走り去っていった。",
      "draft_ko": "내가 깨어난 걸 알아차리자 레테는 폴짝 침대에서 뛰어내려 달아났다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1641",
      "sequence": 360,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1641,
      "speaker": "rinka",
      "source_jp": "「相変わらず自由だなぁ」",
      "draft_ko": "“여전히 제멋대로네.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1643",
      "sequence": 361,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1643,
      "speaker": "narrator",
      "source_jp": "レテは本当に自由で、普段どこにいるか私も分からない。ただお客さんに迷惑をかけないし、トイレはちゃんと覚えているので放っておいている。",
      "draft_ko": "레테는 정말 자유분방해서 평소 어디에 있는지 나도 모른다. 그래도 손님에게 폐를 끼치지 않고 화장실도 제대로 가리니 내버려 두고 있다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1645",
      "sequence": 362,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1645,
      "speaker": "narrator",
      "source_jp": "猫を縛ろうとするのは雲をつかむのと同じ――おばあちゃんの口癖だ。まあつまり、おばあちゃんもレテには手を焼いていたということである。",
      "draft_ko": "고양이를 붙잡아 두려는 건 구름을 잡는 것과 같다――할머니의 입버릇이다. 뭐, 결국 할머니도 레테 때문에 애를 먹었다는 뜻이다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1650",
      "sequence": 363,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1650,
      "speaker": "rinka",
      "source_jp": "「んん……」",
      "draft_ko": "“으으……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1652",
      "sequence": 364,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1652,
      "speaker": "narrator",
      "source_jp": "今日は祝日だから、朝からお店を開けなければいけない。背伸びをして、私は準備を始めた。",
      "draft_ko": "오늘은 공휴일이라 아침부터 가게를 열어야 한다. 기지개를 켜고 나는 준비를 시작했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1663",
      "sequence": 365,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1663,
      "speaker": "narrator",
      "source_jp": "モーニングのお客さんが帰って落ち着いた頃に、からんからんと入り口のベルが鳴った。",
      "draft_ko": "아침 손님들이 돌아가고 한가해졌을 무렵, 딸랑딸랑 입구 종이 울렸다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1668",
      "sequence": 366,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1668,
      "speaker": "rinka",
      "source_jp": "「いらっしゃいま……あ、海晴？」",
      "draft_ko": "“어서 오세…… 어, 미하루?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1677",
      "sequence": 367,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1677,
      "speaker": "miharu",
      "source_jp": "「おはよう凛火」",
      "draft_ko": "“좋은 아침, 린카.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1679",
      "sequence": 368,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1679,
      "speaker": "narrator",
      "source_jp": "入ってきたのは、背が高くスタイルのいい美少女だ。長い髪はさらさらで、歩くたびに光を反射して滑らかな波を作る。",
      "draft_ko": "들어온 사람은 키가 크고 몸매가 좋은 미소녀다. 긴 머리카락은 찰랑거렸고, 걸을 때마다 빛을 반사하며 부드러운 물결을 만들었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1681",
      "sequence": 369,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1681,
      "speaker": "narrator",
      "source_jp": "未島海晴――私の仲の良いクラスメイトであり、避けられ組の一員だ。海晴の場合は、容姿端麗で成績優秀と、完璧すぎて周囲と壁があるんだと思う。",
      "draft_ko": "미시마 미하루――나와 친한 동급생이자, 모두가 피하는 아이들 중 한 명이다. 미하루의 경우에는 용모도 빼어나고 성적도 우수해서, 너무 완벽한 탓에 주변과 벽이 생긴 것 같다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1685",
      "sequence": 370,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1685,
      "speaker": "rinka",
      "source_jp": "「あれ？　今日はバイト休み？」",
      "draft_ko": "“어라? 오늘은 알바 쉬는 날이야?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1689",
      "sequence": 371,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1689,
      "speaker": "miharu",
      "source_jp": "「ううん、今日はこれからバイトだよ」",
      "draft_ko": "“아니, 오늘은 이제부터 알바하러 가.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1691",
      "sequence": 372,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1691,
      "speaker": "narrator",
      "source_jp": "言われてみれば、凛火は休みの日なのに制服を着ていた。遊びに行くときは私服だが、バイトの時は服を選ぶのが億劫だから制服にしているらしい。",
      "draft_ko": "그러고 보니 미하루는 쉬는 날인데도 교복을 입고 있었다. 놀러 갈 때는 사복을 입지만, 알바할 때는 옷 고르기가 귀찮아서 교복을 입는다고 한다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1693",
      "sequence": 373,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1693,
      "speaker": "narrator",
      "source_jp": "制服であれば、バイト帰りに変な男から声をかけられるのも防げるらしい。理由は詳しくは分からないけれど、海晴なりの対策だそうだ。",
      "draft_ko": "교복이면 알바를 마치고 돌아가는 길에 이상한 남자가 말을 거는 것도 막을 수 있다고 한다. 자세한 이유는 모르겠지만, 미하루 나름의 대책이란다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1695",
      "sequence": 374,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1695,
      "speaker": "narrator",
      "source_jp": "ただ、海晴のバイト先は秋葉原。ここは新宿方面だから、海晴の家からバイト先に向かうには逆方向で、寄り道にもならないはずだ。何か用事があるのだろうか。",
      "draft_ko": "하지만 미하루의 알바 장소는 아키하바라다. 이곳은 신주쿠 쪽이니, 미하루 집에서 알바하러 가려면 반대 방향이라 가는 길에 들를 만한 곳도 아니다. 무슨 볼일이라도 있는 걸까.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1699",
      "sequence": 375,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1699,
      "speaker": "miharu",
      "source_jp": "「ぼくはただ凛火の顔を見たかっただけだよ。昨日はほとんど話せなかったのに、今日から連休になってしまうからね。せめて今日くらいは、凛火と話しておきたくて」",
      "draft_ko": "“난 그냥 린카 얼굴이 보고 싶었을 뿐이야. 어제는 거의 얘기도 못 했는데 오늘부터 연휴잖아. 적어도 오늘 정도는 린카와 이야기해 두고 싶어서.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1703",
      "sequence": 376,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1703,
      "speaker": "rinka",
      "source_jp": "「は、はぁ……。どうも」",
      "draft_ko": "“아, 그래…… 고마워.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1705",
      "sequence": 377,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1705,
      "speaker": "narrator",
      "source_jp": "正直言って、海晴にはよく分からないところも多い。",
      "draft_ko": "솔직히 미하루는 잘 이해되지 않는 구석이 많다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1707",
      "sequence": 378,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1707,
      "speaker": "narrator",
      "source_jp": "たぶん本当は別の用事が新宿方面であったと思うのだが、こういうからかい方をしてくるのだ。うまい返答の仕方を、私は知らない。",
      "draft_ko": "아마 사실은 신주쿠 쪽에 다른 볼일이 있었겠지만, 이런 식으로 나를 놀린다. 뭐라고 받아쳐야 좋을지 나는 모른다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
