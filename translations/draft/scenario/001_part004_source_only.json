      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1760,
      "speaker": "narrator",
      "source_jp": "スターダストキングダムとは、千葉県にある有名なテーマパークだ。",
      "draft_ko": "스타더스트 킹덤은 치바현에 있는 유명한 테마파크다.",
