  "entries": [
    {
      "stable_id": "scenario/001.rpy::L1798",
      "sequence": 401,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1798,
      "speaker": "naomi",
      "source_jp": "「あ……おはようございます」",
      "draft_ko": "“아…… 안녕하세요.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1803",
      "sequence": 402,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1803,
      "speaker": "rinka",
      "source_jp": "「おはよう。いいよ、気にしないで入って」",
      "draft_ko": "“좋은 아침. 괜찮으니까 신경 쓰지 말고 들어와.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1805",
      "sequence": 403,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1805,
      "speaker": "narrator",
      "source_jp": "海晴のことは特に触れなかったので、すれ違いにはならなかったのだろうか。",
      "draft_ko": "미하루 이야기는 따로 하지 않았으니, 오는 길에 서로 스쳐 지나가지는 않았나 보다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1807",
      "sequence": 404,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1807,
      "speaker": "narrator",
      "source_jp": "直未は少し元気がないようにも見える。",
      "draft_ko": "나오미는 조금 기운이 없어 보이기도 했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1809",
      "sequence": 405,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1809,
      "speaker": "narrator",
      "source_jp": "他にお客さんはいなかったが、やはりお店ということもあり、入るかどうか躊躇しているようだった。",
      "draft_ko": "다른 손님은 없었지만 역시 가게인 탓인지, 들어올지 말지 망설이는 듯했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1814",
      "sequence": 406,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1814,
      "speaker": "rinka",
      "source_jp": "「どうしたの？」",
      "draft_ko": "“무슨 일이야?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1816",
      "sequence": 407,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1816,
      "speaker": "narrator",
      "source_jp": "おばあちゃんには、まだ直未のことを相談していなかった。当然、初心者でも比較的簡単で、美味しく飲めるコーヒーの情報はまだない。",
      "draft_ko": "할머니에게는 아직 나오미 이야기를 상의하지 않았다. 당연히 초보자도 비교적 쉽게 맛있게 마실 수 있는 커피에 대한 정보는 아직 없다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1818",
      "sequence": 408,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1818,
      "speaker": "narrator",
      "source_jp": "私が一から教えるという手もあったが、中途半端な知識で教えたくなかった。",
      "draft_ko": "내가 처음부터 가르치는 방법도 있었지만, 어설픈 지식으로 가르치고 싶지는 않았다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1823",
      "sequence": 409,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1823,
      "speaker": "naomi",
      "source_jp": "「実は、昨日忘れ物をしてしまったみたいで……」",
      "draft_ko": "“사실 어제 물건을 두고 간 것 같아서요……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1827",
      "sequence": 410,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1827,
      "speaker": "rinka",
      "source_jp": "「忘れ物？　もしかして本？　分厚くて、金色の歯車みたいな飾りのついた立派なやつ」",
      "draft_ko": "“두고 간 물건? 혹시 책이야? 두껍고 금빛 톱니바퀴 같은 장식이 달린 멋진 책.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1832",
      "sequence": 411,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1832,
      "speaker": "naomi",
      "source_jp": "「本……ですか？　いえ、わたし本は忘れていないと思いますけど」",
      "draft_ko": "“책……이요? 아니요, 저는 책은 두고 가지 않은 것 같은데요.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1837",
      "sequence": 412,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1837,
      "speaker": "rinka",
      "source_jp": "「そっか、だよね」",
      "draft_ko": "“그렇구나. 하긴 그렇지.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1839",
      "sequence": 413,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1839,
      "speaker": "narrator",
      "source_jp": "聞いてみたはいいものの、私の部屋には上げていないから忘れるはずもないか。",
      "draft_ko": "물어보기는 했지만, 내 방에는 들이지 않았으니 두고 갈 리도 없나.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1841",
      "sequence": 414,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1841,
      "speaker": "narrator",
      "source_jp": "直未の忘れ物は筆箱らしい。",
      "draft_ko": "나오미가 잃어버린 건 필통인 모양이다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1843",
      "sequence": 415,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1843,
      "speaker": "narrator",
      "source_jp": "昨晩チャットで送ってもらえればよかったのだが、今朝気付いたらしく、私がお店に立ってからメッセージを送っていたらしい。",
      "draft_ko": "어젯밤 채팅으로 알려 줬으면 좋았겠지만, 오늘 아침에야 알아챈 모양이라 내가 가게에 나온 뒤 메시지를 보냈다고 한다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1845",
      "sequence": 416,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1845,
      "speaker": "narrator",
      "source_jp": "直未は新宿が定期圏内らしく、散歩も兼ねてわざわざ来てくれたそうだ。",
      "draft_ko": "나오미는 신주쿠가 정기권 구간 안인 듯했고, 산책도 할 겸 일부러 찾아왔다고 한다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1850",
      "sequence": 417,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1850,
      "speaker": "naomi",
      "source_jp": "「あ、お母さんからチャットだ。えっと、キッチンのテーブルの上に置きっぱなしだったみたいです……、すみません……」",
      "draft_ko": "“아, 엄마한테 채팅 왔다. 음, 부엌 식탁 위에 그대로 뒀나 봐요…… 죄송해요……”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1852",
      "sequence": 418,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1852,
      "speaker": "narrator",
      "source_jp": "と、どうやら早とちりだったらしい。",
      "draft_ko": "그렇다는 건, 아무래도 지레짐작이었던 모양이다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1854",
      "sequence": 419,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1854,
      "speaker": "narrator",
      "source_jp": "勘違いでわざわざ外出までしてしまうあたり、直未らしいというか……。",
      "draft_ko": "착각 때문에 굳이 외출까지 해 버리는 게 나오미답다고 해야 하나…….",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1859",
      "sequence": 420,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1859,
      "speaker": "naomi",
      "source_jp": "「ところで先輩、その本ってどんなのですか？」",
      "draft_ko": "“그런데 선배, 그 책은 어떤 책이에요?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1861",
      "sequence": 421,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1861,
      "speaker": "narrator",
      "source_jp": "直未は意外なところで話題を掘り返して来た。",
      "draft_ko": "나오미는 뜻밖의 대목에서 다시 그 이야기를 꺼냈다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1866",
      "sequence": 422,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1866,
      "speaker": "rinka",
      "source_jp": "「本？　気になるの？」",
      "draft_ko": "“책? 궁금해?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1871",
      "sequence": 423,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1871,
      "speaker": "naomi",
      "source_jp": "「はい！　立派な本ってどんなものか興味があるんです」",
      "draft_ko": "“네! 그렇게 멋진 책은 어떤 건지 궁금해요.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1876",
      "sequence": 424,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1876,
      "speaker": "rinka",
      "source_jp": "「ふぅん、本好きなんだね。ちょっと待ってて」",
      "draft_ko": "“흐음, 책을 좋아하는구나. 잠깐 기다려.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1880",
      "sequence": 425,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1880,
      "speaker": "narrator",
      "source_jp": "今はお客さんもいないし、窓から見て通りも落ち着いているようなので、私は２階へ本を取りに行った。",
      "draft_ko": "지금은 손님도 없고 창밖으로 보니 거리도 한산한 듯해서, 나는 2층으로 책을 가지러 갔다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1885",
      "sequence": 426,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1885,
      "speaker": "rinka",
      "source_jp": "「おまたせ。これだよ」",
      "draft_ko": "“기다렸지? 이거야.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1889",
      "sequence": 427,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1889,
      "speaker": "narrator",
      "source_jp": "赤茶の表紙に、金色の装飾。",
      "draft_ko": "적갈색 표지에 금빛 장식.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1891",
      "sequence": 428,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1891,
      "speaker": "narrator",
      "source_jp": "見るからに高級な本を目の前にして、直未は「おおっ」と感嘆の声をあげていた。",
      "draft_ko": "보기만 해도 고급스러운 책을 앞에 두고 나오미는 ‘오오!’ 하고 감탄했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1896",
      "sequence": 429,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1896,
      "speaker": "naomi",
      "source_jp": "「思った以上に立派ですね。結構昔の本みたいなのに、古い匂いがしません。あの、開いてもいいですか？」",
      "draft_ko": "“생각했던 것보다도 훨씬 멋지네요. 꽤 오래된 책 같은데 낡은 냄새가 안 나요. 저기, 펼쳐 봐도 될까요?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1901",
      "sequence": 430,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1901,
      "speaker": "rinka",
      "source_jp": "「いいけど、その本変なんだ」",
      "draft_ko": "“그래도 되는데, 그 책 좀 이상해.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1906",
      "sequence": 431,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1906,
      "speaker": "naomi",
      "source_jp": "「変、ですか？」",
      "draft_ko": "“이상하다니요?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L1912",
      "sequence": 432,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 1912,
      "speaker": "narrator",
      "source_jp": "直未は本を開くと、早速不思議そうな顔を浮かべた。",
