# sequence: 205
# source: scenario/012_01GH.rpy:756
# source_jp: あの日、あの場所で、約束したこと。
translate korean f012_01GH_12011542:
    "그날, 그곳에서 한 약속."

# sequence: 206
# source: scenario/012_01GH.rpy:761
