translate korean f012_01GH_c943eeb2:
    voice get_voice_filename("rnk")
    rinka "「불꽃놀이 축제. 이건 반드시 가야 해. 약속했으니까」"

# sequence: 207
# source: scenario/012_01GH.rpy:763
# source_jp: 海晴とも。
