# sequence: 208
# source: scenario/012_01GH.rpy:768
# source_jp: 「あれ、そんな約束したっけ？」
translate korean f012_01GH_0a812f1b:
    voice get_voice_filename("mao")
    mao "「어라, 그런 약속 했었나?」"

# sequence: 209
# source: scenario/012_01GH.rpy:773
# source_jp: 「してたよーな、してたよーな」
translate korean f012_01GH_178d3dfe:
    voice get_voice_filename("mao")
    mao "「했던 것 같기도, 했던 것 같기도」"

# sequence: 210
