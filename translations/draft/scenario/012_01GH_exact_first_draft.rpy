# sequence: 228
# source: scenario/012_01GH.rpy:852
# source_jp: 「にゃにゃっ」
translate korean f012_01GH_3156ac2b:
    voice get_voice_filename("cat")
    lete "「야옹야옹」"

# sequence: 229
# source: scenario/012_01GH.rpy:854
