translate korean f012_01GH_7456eb4b:
    voice get_voice_filename("let")
    lete_unk1 "「이런, 소멸이라고 해서는 안 됐군」"

# sequence: 251
# source: scenario/012_01GH.rpy:941
# source_jp: 「それが何を意味するのか、君はすでに分かっているのかもしれないけれど」
