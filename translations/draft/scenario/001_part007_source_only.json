  "entries": [
    {
      "stable_id": "scenario/001.rpy::L2222",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2222,
      "speaker": "narrator",
      "source_jp": "家には似たような装丁の本があるようだが、中身はカードブックなどではなく普通の本らしい。",
      "draft_ko": "집에는 비슷하게 장정된 책이 있는 모양이지만, 속은 카드북 같은 게 아니라 평범한 책이라고 한다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2224",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2224,
      "speaker": "narrator",
      "source_jp": "こんな豪華な本と似ているものがうちにあるのはそれはそれで気になったが、おばあちゃんの部屋で探すほどの気もおきなかった。",
      "draft_ko": "이렇게 화려한 책과 비슷한 물건이 우리 집에 있다는 것도 나름 신경 쓰였지만, 할머니 방까지 뒤져 볼 마음은 들지 않았다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2231",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2231,
      "speaker": "narrator",
      "source_jp": "あの本はどうしようか。",
      "draft_ko": "그 책은 어떻게 할까.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2247",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2247,
      "speaker": "narrator",
      "source_jp": "お小遣いに換えてしまおうとも思ったが、中身がないのにどこで買ってくれるのか分からない。",
      "draft_ko": "용돈으로 바꿔 버릴까도 생각했지만, 내용물이 없는데 어디서 사 줄지 모르겠다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2249",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2249,
      "speaker": "narrator",
      "source_jp": "それに売りに行くにしても、とりあえず中を見てみないと駄目……か。",
      "draft_ko": "게다가 팔러 가더라도 일단 안쪽을 살펴보지 않으면 안 되려나…….",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2255",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2255,
      "speaker": "narrator",
      "source_jp": "そういえば、中にカードが入っていると直未は言っていた。",
      "draft_ko": "그러고 보니 나오미가 안에 카드가 들어 있다고 했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2257",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2257,
      "speaker": "narrator",
      "source_jp": "どんなものか、見てみようか。",
      "draft_ko": "어떤 건지 한번 볼까.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2267",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2267,
      "speaker": "narrator",
      "source_jp": "私は本をひっくり返して、カードを取り出してみた。",
      "draft_ko": "나는 책을 뒤집어 카드를 꺼내 보았다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2269",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2269,
      "speaker": "narrator",
      "source_jp": "全部で４枚だ。どれも本の表紙の柄に似ている同じ絵柄なので、こちらが裏面だろう。",
      "draft_ko": "전부 네 장이다. 어느 것이나 책 표지 무늬와 비슷한 같은 그림이니 이쪽이 뒷면이겠지.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2271",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2271,
      "speaker": "narrator",
      "source_jp": "カードを裏返すと、白を基調としたデザインに何か書かれていた。",
      "draft_ko": "카드를 뒤집자 흰색을 바탕으로 한 디자인 위에 무언가 적혀 있었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2275",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2275,
      "speaker": "narrator",
      "source_jp": "文字は英語のようだったが、何故だろう、自然と読むことができた。",
      "draft_ko": "글자는 영어인 듯했지만, 어째서인지 자연스럽게 읽을 수 있었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2279",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2279,
      "speaker": "narrator",
      "source_jp": "――Ⅰ・氏名・獅子舞凛火。",
      "draft_ko": "――Ⅰ·성명·시시마이 린카.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2281",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2281,
      "speaker": "narrator",
      "source_jp": "――Ⅲ・氏名・フェデリーコ・カルミナーティ。",
      "draft_ko": "――Ⅲ·성명·페데리코 카르미나티.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2283",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2283,
      "speaker": "narrator",
      "source_jp": "――Ⅳ・死因・焼死。",
      "draft_ko": "――Ⅳ·사인·소사.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2285",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2285,
      "speaker": "narrator",
      "source_jp": "――Ⅸ・未練・金メダル。",
      "draft_ko": "――Ⅸ·미련·금메달.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2299",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2299,
      "speaker": "rinka",
      "source_jp": "「どうして、私の名前が？」",
      "draft_ko": "“왜 내 이름이?”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2306",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2306,
      "speaker": "narrator",
      "source_jp": "思わず、そう声に出していた。",
      "draft_ko": "나도 모르게 그렇게 소리 내어 말했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2308",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2308,
      "speaker": "narrator",
      "source_jp": "他のカードも意味が分からなかったが、死因とか未練とか穏やかではなさそうだ。",
      "draft_ko": "다른 카드들도 무슨 뜻인지 알 수 없었지만, 사인이나 미련 같은 단어는 심상치 않았다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2310",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2310,
      "speaker": "narrator",
      "source_jp": "番号が書いてあるので、きっと他にもたくさんカードがあるに違いない。やはり、この空洞にぴったり収まるくらいは枚数があるのだろう。",
      "draft_ko": "번호가 적혀 있으니 분명 다른 카드도 많이 있을 것이다. 역시 이 빈 공간에 꼭 맞게 들어갈 만큼 장수가 있는 걸까.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2312",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2312,
      "speaker": "narrator",
      "source_jp": "いつの間にか紛失してしまったのか。そもそも、どうしてこの本は私の机の上にあったのだろう。",
      "draft_ko": "언제 잃어버린 걸까. 애초에 이 책은 왜 내 책상 위에 있었던 거지.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2314",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2314,
      "speaker": "narrator",
      "source_jp": "念の為ネットで画像検索してみても、この奇妙なカードブックについてのめぼしい情報は出てこなかった。",
      "draft_ko": "혹시 몰라 인터넷에서 이미지 검색을 해 봤지만, 이 기묘한 카드북에 관한 쓸 만한 정보는 나오지 않았다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2319",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2319,
      "speaker": "rinka",
      "source_jp": "「でもこれ氏名とか書いてあるし、個人情報だよなぁ。同姓同名ってわけもないだろうし」",
      "draft_ko": "“하지만 여기에 성명 같은 게 적혀 있고, 개인정보잖아. 동명이인일 리도 없고.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2321",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2321,
      "speaker": "narrator",
      "source_jp": "となると、売ることはできない。",
      "draft_ko": "그렇다면 팔 수는 없다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2323",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2323,
      "speaker": "narrator",
      "source_jp": "とりあえずカードを本の中に戻して、本棚にしまった。",
      "draft_ko": "일단 카드를 책 안에 돌려놓고 책장에 넣었다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2325",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2325,
      "speaker": "narrator",
      "source_jp": "今度直未にも見せてみよう。一緒に調べればまた違うかもしれない。",
      "draft_ko": "다음에 나오미에게도 보여 주자. 함께 조사하면 뭔가 다를지도 모른다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2330",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2330,
      "speaker": "rinka",
      "source_jp": "「それより、真央に連絡しないと」",
      "draft_ko": "“그보다 마오한테 연락해야지.”",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2337",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2337,
      "speaker": "narrator",
      "source_jp": "スマホを開いて真央に直未がスターダストキングダムに来ることを連絡すると、すぐに既読がつき、返事が来た。",
      "draft_ko": "스마트폰을 열어 마오에게 나오미가 스타더스트 킹덤에 온다고 알리자 곧바로 읽음 표시가 뜨고 답장이 왔다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2341",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2341,
      "speaker": "mao",
      "source_jp": "『マジ？　マジで？　うわー、いやなおりんと行くのは楽しみなんだけど、んっと……んーまあいいや。みはるんにはうちから伝えておくから』",
      "draft_ko": "‘진짜? 진짜로? 우와, 아니, 나오링이랑 가는 건 기대되는데, 음…… 으음, 뭐 됐어. 미하룽한테는 내가 전해 둘게.’",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2343",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2343,
      "speaker": "narrator",
      "source_jp": "真央はどこか様子がおかしかったが、話してみると直未と行くのは問題ないとのことだ。",
      "draft_ko": "마오는 어딘가 상태가 이상했지만, 이야기를 나눠 보니 나오미와 함께 가는 건 문제없다고 했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2345",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
      "source_line": 2345,
      "speaker": "narrator",
      "source_jp": "ただ、「うちが予定を立てるからみはるんにはくれぐれも連絡しなくていいからね」と念を押された。",
      "draft_ko": "다만 ‘내가 계획을 세울 테니까 미하룽한테는 절대로 연락하지 마’라고 거듭 당부했다.",
      "source_authority": "Japanese only",
      "english_reference_used": false,
      "status": "first_draft_unreviewed",
      "qa": "deferred_until_full_first_draft"
    },
    {
      "stable_id": "scenario/001.rpy::L2347",
      "sequence": null,
      "translation_id": null,
      "translation_id_status": "pending_ast_alignment",
      "source_file": "scenario/001.rpy",
