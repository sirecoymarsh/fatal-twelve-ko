Dialogue: 1,0:00:32.94,0:00:38.22,Original,,0,0,0,,高い空見上げて
Dialogue: 1,0:00:32.94,0:00:38.22,Korean,,0,0,0,,높은 하늘을 올려다보며
Dialogue: 1,0:00:38.22,0:00:42.50,Original,,0,0,0,,太陽と手を繋いでいた
Dialogue: 1,0:00:38.22,0:00:42.50,Korean,,0,0,0,,태양과 손을 맞잡고 있었지
Dialogue: 1,0:00:43.56,0:00:47.70,Original,,0,0,0,,あれからずっと 二人の距離は
Dialogue: 1,0:00:43.56,0:00:47.70,Korean,,0,0,0,,그때부터 줄곧 우리 사이는
Dialogue: 1,0:00:47.70,0:00:52.70,Original,,0,0,0,,触れ合うことない指先のまま
Dialogue: 1,0:00:47.70,0:00:52.70,Korean,,0,0,0,,닿지 않는 손끝처럼 떨어져 있었어
Dialogue: 1,0:00:53.24,0:00:55.60,Original,,0,0,0,,ガラスの糸で 紡がれた
Dialogue: 1,0:00:53.24,0:00:55.60,Korean,,0,0,0,,유리의 실로 자아낸
Dialogue: 1,0:00:55.60,0:01:00.40,Original,,0,0,0,,時計仕掛けの運命が
Dialogue: 1,0:00:55.60,0:01:00.40,Korean,,0,0,0,,시계장치 같은 운명이
Dialogue: 1,0:01:00.40,0:01:06.18,Original,,0,0,0,,たとえ砕けそうなほど儚くても
Dialogue: 1,0:01:00.40,0:01:06.18,Korean,,0,0,0,,금방이라도 부서질 만큼 덧없다 해도
Dialogue: 1,0:01:06.18,0:01:10.88,Original,,0,0,0,,幼い日 願った想い 叶えたい
Dialogue: 1,0:01:06.18,0:01:10.88,Korean,,0,0,0,,어린 날 품었던 소원을 이루고 싶어
Dialogue: 1,0:01:10.88,0:01:14.92,Original,,0,0,0,,透明に消えてしまわないように
Dialogue: 1,0:01:10.88,0:01:14.92,Korean,,0,0,0,,투명하게 사라져 버리지 않도록
Dialogue: 1,0:01:14.92,0:01:18.58,Original,,0,0,0,,私がその手を握るよ
Dialogue: 1,0:01:14.92,0:01:18.58,Korean,,0,0,0,,내가 그 손을 잡을게
Dialogue: 1,0:01:18.58,0:01:21.30,Original,,0,0,0,,どうか壊れないで
Dialogue: 1,0:01:18.58,0:01:21.30,Korean,,0,0,0,,부디 부서지지 마
Dialogue: 1,0:01:21.30,0:01:25.80,Original,,0,0,0,,長く伸びたあなたの
Dialogue: 1,0:01:21.30,0:01:25.80,Korean,,0,0,0,,길게 드리워진 네
Dialogue: 1,0:01:25.80,0:01:30.60,Original,,0,0,0,,影を確かに見つけた
Dialogue: 1,0:01:25.80,0:01:30.60,Korean,,0,0,0,,그림자를 분명히 보았어
Dialogue: 1,0:01:31.48,0:01:35.70,Original,,0,0,0,,もう春が終わるねと
Dialogue: 1,0:01:31.48,0:01:35.70,Korean,,0,0,0,,이제 봄도 끝나 가네, 라며
Dialogue: 1,0:01:35.70,0:01:40.30,Original,,0,0,0,,夕焼けにはにかんでいた
Dialogue: 1,0:01:35.70,0:01:40.30,Korean,,0,0,0,,노을 속에서 수줍게 웃었지
Dialogue: 1,0:01:41.20,0:01:45.40,Original,,0,0,0,,寂しい風を抱きしめたとき
Dialogue: 1,0:01:41.20,0:01:45.40,Korean,,0,0,0,,쓸쓸한 바람을 끌어안았을 때
Dialogue: 1,0:01:45.96,0:01:50.40,Original,,0,0,0,,触れ合う心が寄り添い出した
Dialogue: 1,0:01:45.96,0:01:50.40,Korean,,0,0,0,,맞닿은 마음이 서로에게 기대기 시작했어
Dialogue: 1,0:01:51.20,0:01:53.40,Original,,0,0,0,,ガラスの糸は 掛け違え
Dialogue: 1,0:01:51.20,0:01:53.40,Korean,,0,0,0,,유리의 실은 어긋나고
Dialogue: 1,0:01:53.40,0:01:58.04,Original,,0,0,0,,時計仕掛けの運命が
Dialogue: 1,0:01:53.40,0:01:58.04,Korean,,0,0,0,,시계장치 같은 운명이
Dialogue: 1,0:01:58.04,0:02:03.68,Original,,0,0,0,,例えば女神の悪戯だとしても
Dialogue: 1,0:01:58.04,0:02:03.68,Korean,,0,0,0,,설령 여신의 장난이라 해도
Dialogue: 1,0:02:03.68,0:02:08.52,Original,,0,0,0,,愛しい日 誓った想い 叶えたい
Dialogue: 1,0:02:03.68,0:02:08.52,Korean,,0,0,0,,소중한 날 맹세한 마음을 이루고 싶어
Dialogue: 1,0:02:08.52,0:02:12.54,Original,,0,0,0,,解れそうになってしまわないように
Dialogue: 1,0:02:08.52,0:02:12.54,Korean,,0,0,0,,올올이 풀려 버리지 않도록
Dialogue: 1,0:02:12.54,0:02:16.20,Original,,0,0,0,,赤い糸 紡ぎ直すよ
Dialogue: 1,0:02:12.54,0:02:16.20,Korean,,0,0,0,,붉은 실을 다시 자아낼게
Dialogue: 1,0:02:16.20,0:02:19.30,Original,,0,0,0,,どうか離れないで
Dialogue: 1,0:02:16.20,0:02:19.30,Korean,,0,0,0,,부디 떨어지지 마
Dialogue: 1,0:02:38.16,0:02:43.14,Original,,0,0,0,,ここじゃない世界にあなたがいても
Dialogue: 1,0:02:38.16,0:02:43.14,Korean,,0,0,0,,네가 이곳 아닌 다른 세상에 있더라도
Dialogue: 1,0:02:43.14,0:02:47.40,Original,,0,0,0,,必ず探し出すよ
Dialogue: 1,0:02:43.14,0:02:47.40,Korean,,0,0,0,,반드시 찾아낼게
Dialogue: 1,0:02:47.82,0:02:52.64,Original,,0,0,0,,一つじゃない世界で 私は目指す
Dialogue: 1,0:02:47.82,0:02:52.64,Korean,,0,0,0,,여러 세상 속에서 널 향해 가
Dialogue: 1,0:02:52.64,0:02:57.40,Original,,0,0,0,,どこでも見つけ出すよ
Dialogue: 1,0:02:52.64,0:02:57.40,Korean,,0,0,0,,어디에 있든 찾아낼게
Dialogue: 1,0:03:00.08,0:03:05.78,Original,,0,0,0,,もしも私の夢だとしたなら
Dialogue: 1,0:03:00.08,0:03:05.78,Korean,,0,0,0,,만약 이 모든 게 나의 꿈이라면
Dialogue: 1,0:03:05.78,0:03:07.78,Original,,0,0,0,,尊い日
Dialogue: 1,0:03:05.78,0:03:07.78,Korean,,0,0,0,,소중했던 날들도
Dialogue: 1,0:03:07.78,0:03:10.86,Original,,0,0,0,,その温もりは偽物ですか
Dialogue: 1,0:03:07.78,0:03:10.86,Korean,,0,0,0,,그 온기마저 거짓인가요
Dialogue: 1,0:03:10.86,0:03:15.16,Original,,0,0,0,,決して切れない透明な糸を
Dialogue: 1,0:03:10.86,0:03:15.16,Korean,,0,0,0,,결코 끊어지지 않는 투명한 실을
Dialogue: 1,0:03:15.16,0:03:18.34,Original,,0,0,0,,一緒に染めていこう
Dialogue: 1,0:03:15.16,0:03:18.34,Korean,,0,0,0,,함께 물들여 가자
Dialogue: 1,0:03:18.34,0:03:23.00,Original,,0,0,0,,どうかずっときっと…
Dialogue: 1,0:03:18.34,0:03:23.00,Korean,,0,0,0,,부디, 언제까지나, 꼭…
